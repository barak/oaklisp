;;; Lists, sequences, strings, characters, symbols, hash tables.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(check "cons car cdr" (let ((p (cons 1 2))) (list (car p) (cdr p))) '(1 2))
(check "list ops" (list (length '(1 2 3)) (reverse '(1 2 3)) (append '(1) '(2) '(3)) (last '(1 2 3))) '(3 (3 2 1) (1 2 3) 3))
(check "nth head tail" (list (nth '(a b c) 1) (head '(a b c) 2) (tail '(a b c) 2)) '(b (a b) (c)))
(check "memq assq" (list (memq 'b '(a b c)) (assq 'b '((a . 1) (b . 2)))) '((b c) (b . 2)))
(check "member assoc" (list (member "b" '("a" "b")) (assoc "b" '(("a" . 1) ("b" . 2)))) '(("b") ("b" . 2)))
(check "map" (map (lambda (x) (* x x)) '(1 2 3)) '(1 4 9))
(check "map two lists" (map + '(1 2 3) '(10 20 30)) '(11 22 33))
(check "for-each" (let ((s 0)) (for-each (lambda (x) (set! s (+ s x))) '(1 2 3)) s) 6)
(check "any? every?" (list (any? even? '(1 2 3)) (every? even? '(1 2 3))) '(#t ()))
(check "remove delq" (list (remove '(1 2 3 2) 2) (delq 'a '(a b a c))) '((1 3) (b c)))
(check "sort" (sort '(3 1 2) <) '(1 2 3))
(check "sort strings" (sort '("pear" "apple" "fig") (lambda (a b) (< (length a) (length b)))) '("fig" "pear" "apple"))
(check "sort stability-ish" (sort '(5 4 3 2 1 0) <) '(0 1 2 3 4 5))
(check "iota" (iota 4) '(1 2 3 4))
(check "union" (sort (union '(1 2) '(2 3)) <) '(1 2 3))
(check "list*" (list* 1 2 '(3)) '(1 2 3))
(check "position-in-list" (position-in-list 'c '(a b c)) 2)
(check "copy" (let ((l '(1 2))) (and (equal? l (copy l)) (not (eq? l (copy l))))) #t)
(check "subseq list" (subseq '(a b c d) 1 2) '(b c))
(check "string length" (length "hello") 5)
(check "string nth" (nth "hello" 1) #\e)
(check "string append" (append "foo" "bar") "foobar")
(check "string subseq" (subseq "hello" 1 3) "ell")
(check "make-string" (make-string 3 #\z) "zzz")
(check "make-string default" (length (make-string 4)) 4)
(check "string upcase" (upcase "abc") "ABC")
(check "string equal" (equal? "abc" (append "ab" "c")) #t)
(check "string->list" (#^list-type "abc") '(#\a #\b #\c))
(check "list->string" (#^string '(#\a #\b)) "ab")
(check "string set" (let ((s (make-string 2 #\a))) (set! (nth s 1) #\b) s) "ab")
(check "long string" (length (let loop ((n 1000) (acc "")) (if (= n 0) acc (loop (- n 1) (append acc "x"))))) 1000)
(check "char compare" (list (< #\a #\b) (upcase #\a) (#^number #\A)) '(#t #\A 65))
(check "symbol intern" (eq? (intern "FOO") 'foo) #t)
(check "symbol name" (#^string 'foo) "FOO")
(check "symbol case" (eq? '|foo| 'foo) #f)
(check "gensym" (symbol? (gensym "G")) #t)
(check "escaped symbol" (#^string '\.\.\.) "...")
(check "vector" (let ((v (make simple-vector 3))) (set! (nth v 1) 'x) (list (length v) (nth v 1))) '(3 x))
(check "vector literal" (nth #(1 2 3) 2) 3)
(check "eq-hash-table" (let ((h (make-eq-hash-table))) (set! (table-entry h 'a) 1) (set! (table-entry h 'b) 2) (list (table-entry h 'a) (table-entry h 'b) (table-entry h 'c))) '(1 2 ()))
(check "equal-hash-table" (let ((h (make-equal-hash-table))) (set! (table-entry h "k") 1) (table-entry h (append "" "k"))) 1)
(check "string-hash-table" (let ((h (make-string-hash-table))) (set! (table-entry h "k") 'v) (table-entry h "k")) 'v)
(check "hash table growth" (let ((h (make-eq-hash-table))) (dotimes (i 5000) (set! (table-entry h i) (* i i))) (list (table-entry h 4999) (table-entry h 0))) '(24990001 0))
(check "present?" (let ((h (make-eq-hash-table))) (set! (present? h 'a) 1) (and (present? h 'a) (not (present? h 'b)))) #t)
(check "lazy cons" (car (lcons 1 (error "not forced"))) 1)
(check "delay force" (force (delay (+ 1 2))) 3)
(check "backquote" `(1 ,(+ 1 1) ,@(list 3 4)) '(1 2 3 4))
(check "quasiquote nested" `(a (b ,(car '(c)))) '(a (b c)))
(check "destructure" (destructure (a (b . c)) '(1 (2 3 4)) (list a b c)) '(1 2 (3 4)))
