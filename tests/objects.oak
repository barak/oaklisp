;;; Types, methods, inheritance, coercers, settable and locatable operations.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(define-instance point type '(x y) (list object))
(add-method (initialize (point x y) self xx yy) (set! x xx) (set! y yy) self)
(define-instance point-x operation)
(add-method (point-x (point x) self) x)
(define-instance point-y settable-operation)
(add-method (point-y (point y) self) y)
(add-method ((setter point-y) (point y) self v) (set! y v))
(define-instance magnitude operation)
(add-method (magnitude (point x y) self) (+ (* x x) (* y y)))

(define p (make point 3 4))
(check "make and accessor" (list (point-x p) (point-y p)) '(3 4))
(check "settable op" (block (set! (point-y p) 10) (point-y p)) 10)
(check "method" (magnitude (make point 1 2)) 5)
(check "get-type" (eq? (get-type p) point) #t)
(check "is-a?" (list (is-a? p point) (is-a? p object) (is-a? 3 point)) '(#t #t ()))
(check "subtype?" (list (subtype? point object) (subtype? object point)) '(#t ()))

(define-instance point3 type '(z) (list point))
(add-method (initialize (point3 z) self xx yy zz) (set! z zz) (^super point initialize self xx yy))
(add-method (magnitude (point3 z) self) (+ (* z z) (^super point magnitude self)))
(define q (make point3 1 2 3))
(check "inheritance" (list (point-x q) (point-y q)) '(1 2))
(check "^super" (magnitude q) 14)
(check "subtype chain" (is-a? q point) #t)

(define-instance named-mixin type '(name) '())
(add-method (initialize (named-mixin name) self n) (set! name n) self)
(define-instance get-name operation)
(add-method (get-name (named-mixin name) self) name)
(define-instance named-point type '() (list named-mixin point))
(add-method (initialize (named-point) self n xx yy)
  (^super named-mixin initialize self n)
  (^super point initialize self xx yy))
(define np (make named-point 'origin 0 0))
(check "multiple inheritance" (list (get-name np) (point-x np)) '(origin 0))

(check "locatable op" (let ((c (%make-cell 1))) (set! (contents c) 5) (contents c)) 5)
(check "make-locative" (let ((v (make simple-vector 2))) (set! (nth v 0) 'a) (let ((l (make-locative (nth v 0)))) (set! (contents l) 'b) (nth v 0))) 'b)
(check "setter of car" (let ((l (list 1 2))) (set! (car l) 9) l) '(9 2))
(check "coercer" (list (#^string 'abc) (#^number #\a) (#^symbol "XYZ")) '("ABC" 97 xyz))
(check "operation types" (list (is-a? car operation) (is-a? point type) (is-a? magnitude operation)) '(#t #t #t))
(check "anonymous lambda" ((lambda (x) (* x 2)) 21) 42)
(check "closure" (let ((counter (let ((n 0)) (lambda () (set! n (+ n 1)) n)))) (counter) (counter)) 2)
(check "closure over ivar" (let ((pt (make point 7 8))) ((lambda () (point-x pt)))) 7)
(check "add-method on object" (block (define-instance greet operation) (add-method (greet (object) self) 'hi) (greet 3)) 'hi)
(check "no method error" (catch-errors (general-error (lambda (e) 'nomethod)) (point-x 3)) 'nomethod)
(check "describe runs" (block (describe p) #t) #t)
(check "print method" (block (add-method (print (point x y) self stream) (format stream "#<point ~D,~D>" x y)) (format #f "~A" (make point 5 6))) "#<point 5,6>")
(check "frozen? car" (not (not (frozen? system-locale 'car))) #t)
(check "define-constant" (block (define-constant seventeen 17) (* seventeen 2)) 34)
(check "fluid op" (let () (set! #*obj-fluid 'a) (bind ((#*obj-fluid 'b)) #*obj-fluid)) 'b)
