;;; Dispatch: slot aliasing in method parameter groups, and dispatch
;;; on the types of more than one argument.  See Multi-Dispatch.md.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)


;;; Slot aliasing: (VAR SLOT) names SLOT but calls it VAR.

(define-instance pt type '(x y) (list object))
(add-method (initialize (pt x y) self a b) (set! x a) (set! y b) self)

(define-instance aliased operation)
(add-method (aliased (pt (a x) (b y)) self) (list a b))

(define-instance aliased-set operation)
(add-method (aliased-set (pt (a x)) self v) (set! a v) a)

(define-instance aliased-loc operation)
(add-method (aliased-loc (pt (a x)) self) (contents (make-locative a)))

(define-instance mixed operation)
(add-method (mixed (pt (a x) y) self) (list a y))

(define p (make pt 3 4))

(check "alias reads slots" (aliased p) '(3 4))
(check "alias assigns slot" (block (aliased-set p 7) (aliased p)) '(7 4))
(check "alias locative" (aliased-loc p) 7)
(check "alias beside plain slot" (mixed p) '(7 4))

;;; The same type twice in one method, which is what aliasing is for:
;;; without it the two slots named X would collide.

(define-instance pt-add operation)
(add-method (pt-add (pt (ax x) (ay y)) self other)
  (list (+ ax (car (aliased other))) (+ ay (cadr (aliased other)))))

(check "two instances of a type" (pt-add (make pt 1 2) (make pt 10 20))
       '(11 22))

;;; Aliasing does not disturb an inherited layout: the slot named is
;;; still looked up in the type the method is added to.

(define-instance pt3 type '(z) (list pt))
(add-method (initialize (pt3 z) self a b c)
  (set! z c)
  (^super pt initialize self a b))
(define-instance pt3-z operation)
(add-method (pt3-z (pt3 (c z)) self) c)

(define q (make pt3 1 2 3))
(check "subtype slots" (list (aliased q) (pt3-z q)) '((1 2) 3))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;              dispatch on more than one argument                    ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-instance shape type '() (list object))
(define-instance circ type '() (list shape))
(define-instance sqr type '() (list shape))
(define-instance round-sqr type '() (list circ sqr))

(define c (make circ))
(define s (make sqr))
(define r (make round-sqr))

(define-instance combine operation)
(add-method (combine (circ) x (circ) y) 'circ-circ)
(add-method (combine (circ) x (sqr) y) 'circ-sqr)
(add-method (combine (circ) x y) 'circ-any)
(add-method (combine (sqr) x (shape) y) 'sqr-shape)

(check "two specializers" (list (combine c c) (combine c s)) '(circ-circ circ-sqr))
(check "unspecialized tail is the fallback" (combine c 7) 'circ-any)
(check "supertype specializer" (list (combine s c) (combine s s))
       '(sqr-shape sqr-shape))

;;; The second argument's own type decides between two entries whose
;;; specializers are related.

(define-instance narrow operation)
(add-method (narrow (circ) x (shape) y) 'shape)
(add-method (narrow (circ) x (circ) y) 'circ)

(check "more specific second argument wins" (narrow c c) 'circ)
(check "less specific second argument applies" (narrow c s) 'shape)

;;; A multimethod is reached through a subtype of its home type, and
;;; the first argument's own type still picks the home type.

(check "subtype of the home type" (combine r c) 'circ-circ)

;;; Three parameters, and a hole in the middle.

(define-instance triple operation)
(add-method (triple (circ) x (sqr) y (circ) z) 'c-s-c)
(add-method (triple (circ) x y (sqr) z) 'c-any-s)
(add-method (triple (circ) x y z) 'c-any-any)

(check "three specializers" (triple c s c) 'c-s-c)
(check "hole in the middle" (triple c 1 s) 'c-any-s)
(check "shortest wins only when it must" (triple c 1 2) 'c-any-any)

;;; Order of definition does not matter: an ordinary single-dispatch
;;; method added after the multimethods becomes their fallback, and
;;; one added before them survives as the fallback.

(define-instance after-op operation)
(add-method (after-op (circ) x (sqr) y) 'specialized)
(add-method (after-op (circ) x y) 'fallback)

(define-instance before-op operation)
(add-method (before-op (circ) x y) 'fallback)
(add-method (before-op (circ) x (sqr) y) 'specialized)

(check "fallback added last" (list (after-op c s) (after-op c 1))
       '(specialized fallback))
(check "fallback added first" (list (before-op c s) (before-op c 1))
       '(specialized fallback))

;;; Replacing an entry replaces just that one.

(define-instance again-op operation)
(add-method (again-op (circ) x (sqr) y) 'first)
(add-method (again-op (circ) x (circ) y) 'other)
(add-method (again-op (circ) x (sqr) y) 'second)

(check "redefining one entry" (list (again-op c s) (again-op c c))
       '(second other))

;;; Methods on an unrelated type are untouched, and so is the
;;; operation's behaviour where it has no multimethod at all.

(define-instance elsewhere operation)
(add-method (elsewhere (circ) x (sqr) y) 'multi)
(add-method (elsewhere (fixnum) x y) 'fixnum)

(check "other home types unaffected" (list (elsewhere c s) (elsewhere 1 2))
       '(multi fixnum))

;;; Instance variables of the first parameter work as always.

(define-instance box type '(v) (list object))
(add-method (initialize (box v) self x) (set! v x) self)
(define-instance unbox operation)
(add-method (unbox (box v) self (circ) y) (list 'circ v))
(add-method (unbox (box v) self (sqr) y) (set! v (+ v 1)) (list 'sqr v))

(define bx (make box 10))
(check "first parameter's slots" (unbox bx c) '(circ 10))
(check "first parameter's slots assigned" (unbox bx s) '(sqr 11))

;;; Zero-argument and one-argument calls still dispatch the way they
;;; always did, now as the short cases of the general rule.

(define-instance nullary operation)
(add-method (nullary (object)) 'none)
(check "zero arguments" (nullary) 'none)

(define-instance unary operation)
(add-method (unary (circ) x) 'one)
(check "one argument" (unary c) 'one)

;;; A promise in a dispatched position is forced and the call retried,
;;; as FSELECT-TYPE would have done.

(check "forced second argument" (combine c (delay (make sqr))) 'circ-sqr)

;;; Instance variables of a parameter after the first, which is what
;;; the symmetric syntax is for: BP holds the frame of the first
;;; argument alone, so these go through a locative the method binds
;;; on the way in.

(define-instance cpx type '(re im) (list object))
(add-method (initialize (cpx re im) self a b) (set! re a) (set! im b) self)
(define-instance parts operation)
(add-method (parts (cpx re im) self) (list re im))

(define-instance cadd operation)
(add-method (cadd (cpx (xr re) (xi im)) x (cpx (yr re) (yi im)) y)
  (list (+ xr yr) (+ xi yi)))

(check "slots of both parameters" (cadd (make cpx 1 2) (make cpx 10 20))
       '(11 22))

(define-instance cbump operation)
(add-method (cbump (cpx) x (cpx (yr re)) y) (set! yr (+ yr 100)) (parts y))

(define-instance cloc operation)
(add-method (cloc (cpx) x (cpx (yr re)) y) (contents (make-locative yr)))

(define z (make cpx 10 20))
(check "assigning a later parameter's slot" (cbump z z) '(110 20))
(check "locative of a later parameter's slot" (cloc z z) 110)

;;; The slot is found in the argument's own frame, so a subtype that
;;; adds instance variables of its own still works.

(define-instance cpx3 type '(w) (list cpx))
(add-method (initialize (cpx3 w) self a b c)
  (set! w c)
  (^super cpx initialize self a b))

(check "subtype as a later argument" (cadd (make cpx 1 2) (make cpx3 10 20 30))
       '(11 22))

;;; A method may name slots of a parameter it dispatches on without
;;; the first parameter being specialized at all.

(define-instance tag-im operation)
(add-method (tag-im x (cpx (b im)) y) b)

(check "slots with an unspecialized first parameter" (tag-im 'anything z) 20)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;        the symmetry dispatching on one argument cannot have      ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;; A promise is forced whichever side of a comparison it is on: the
;;; first argument by the method FORCIBLE has, the second because the
;;; methods of these operations dispatch on it and the one that
;;; matched the promise matched it only through OBJECT.

(check "eqv? forces the first argument"  (eqv? (delay 3) 3) #t)
(check "eqv? forces the second argument" (eqv? 3 (delay 3)) #t)
(check "eqv? forces both"  (eqv? (delay 3) (delay 3)) #t)
(check "equal? forces the first argument"  (equal? (delay 3) 3) #t)
(check "equal? forces the second argument" (equal? 3 (delay 3)) #t)
(check "equal? forces a string"  (equal? "ab" (delay (copy "ab"))) #t)
(check "equal? forces a list"    (equal? '(1 2) (delay (list 1 2))) #t)
(check "= forces either argument"
       (list (= (delay 3) 3) (= 3 (delay 3))) '(#t #t))
(check "< forces either argument"
       (list (< (delay 3) 4) (< 3 (delay 4))) '(#t #t))

;;; An unspecialized parameter matches an operation, whose type the
;;; kernel builds by hand and does not make a subtype of OBJECT.

(check "a hole matches an operation" (eqv? 3 car) #f)
(check "a hole matches an operation the other way" (eqv? car 3) #f)

;;; Comparing across kinds is the same error whichever side it is on.

(define (errs? thunk) (catch-errors (general-error (lambda (e) 'err)) (thunk)))

;;; The operands go through variables: these are foldable operations,
;;; and the compiler would otherwise announce each error as it tried.

(define three 3)
(define a-string "a")
(define a-char #\a)
(define a-list '(1))

(check "= number with string"
       (list (errs? (lambda () (= three a-string)))
	     (errs? (lambda () (= a-string three))))
       '(err err))
(check "= number with character"
       (list (errs? (lambda () (= three a-char)))
	     (errs? (lambda () (= a-char three))))
       '(err err))
(check "< string with list"
       (list (errs? (lambda () (< a-string a-list)))
	     (errs? (lambda () (< a-list a-string))))
       '(err err))
(check "and still compares within a kind"
       (list (= "ab" (copy "ab")) (= "ab" "ba") (= #\a #\a) (= #\a #\b)
	     (< "ab" "b") (< #\a #\b))
       '(#t #f #t #f #t #t))

;;; A multimethod whose home type is OBJECT absorbs the plain method
;;; that was there, whichever order they are added in.

(define-instance home-obj operation)
(add-method (home-obj x y) 'fallback)
(add-method (home-obj x (circ) y) 'shaped)
(check "object as the home type"
       (list (home-obj 1 2) (home-obj 1 c)) '(fallback shaped))


;;; The method chosen is remembered by the tuple of argument types,
;;; the first argument's among them: the instance variable frame
;;; offset kept beside it was computed from that type, and these two
;;; subtypes of the home type put the home type's frame in different
;;; places.

(define-instance padding type '(pad) (list object))
(define-instance holder type '(held) (list object))
(define-instance kid-one type '() (list holder padding))
(define-instance kid-two type '() (list padding holder))

(define-instance set-held operation)
(add-method (set-held (holder held) self v) (set! held v) self)

(define-instance get-held operation)
(add-method (get-held (holder held) self (circ) y) held)
(add-method (get-held (holder held) self y) (list 'other held))

(define k1 (set-held (make kid-one) 'one))
(define k2 (set-held (make kid-two) 'two))

(check "frame offset per first argument type"
       (list (get-held k1 c) (get-held k2 c) (get-held k1 c))
       '(one two one))


;;; HAS-METHOD? sees a multimethod.

(check "has-method?" (and (has-method? circ combine) #t) #t)

;;; eof
