;;; Promises (DELAY makes a lazy future-obj, see multiproc.oak; FUTURE
;;; a scheduled one), FORCE, LCONS, and the automatic forcing of
;;; a forcible passed where an operation wants a real value (the tag
;;; trap handler retries the operation on the forced value).  This
;;; broke once when a mutex primitive under FORCE trapped with the
;;; wrong number of arguments: "unexpected trap from argless
;;; instruction 71".

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))
(set! #*print-length #f)
(set! #*print-level #f)

(check "force" (force (delay (+ 1 2))) 3)
(check "force non-promise" (force 5) 5)
(check "memoized" (let* ((n 0) (p (delay (block (set! n (+ n 1)) n)))) (force p) (force p) (list (force p) n)) '(1 1))
(check "autoforce +" (+ 1 (delay 2)) 3)
(check "autoforce + reversed" (+ (delay 2) 1) 3)
(check "autoforce both" (let ((p (delay 2))) (+ p p)) 4)
(check "autoforce *" (* 2 (delay 3)) 6)
(check "autoforce -" (- (delay 5)) -5)
(check "autoforce <" (< 1 (delay 2)) #t)
(check "autoforce =" (= 2 (delay 2)) #t)
(check "autoforce quotient" (quotient (delay 7) 2) 3)
(check "autoforce ash" (ash-left (delay 1) 3) 8)
(check "autoforce bignum" (+ 1 (delay (expt 2 70))) (+ 1 (expt 2 70)))
(check "autoforce rational" (+ (delay 1/2) 1) 3/2)
(check "autoforce car" (car (delay (list 1 2))) 1)
(check "autoforce cdr" (cdr (delay (list 1 2))) '(2))
(check "autoforce nth" (nth (delay (list 1 2)) 1) 2)
(check "autoforce length" (length (delay (list 1 2 3))) 3)
(check "autoforce string" (length (delay "abc")) 3)
(check "autoforce nested" (+ 1 (delay (+ 1 (delay 1)))) 3)
(check "autoforce operator" ((delay car) '(9)) 9)
(check "autoforce in apply" (apply + (list 1 (delay 2))) 3)
(check "eq? does not force" (eq? 2 (delay 2)) #f)
(check "eqv? forces" (eqv? (delay 2) 2) #t)
(check "equal? forces" (equal? '(1 2) (delay (list 1 2))) #t)
(check "print transparent" (format #f "~S" (delay 42)) "42")
(check "print in list" (format #f "~S" (list 1 (delay 2))) "(1 2)")
(check "print magic off" (let ((p (delay 42))) (force p) (bind ((#*forcible-print-magic #f)) (not (not (subsequence? "#<" (format #f "~S" p)))))) #t)
(check "lcons" (car (lcons 1 (error "never"))) 1)
(check "lcons cdr forces" (cadr (lcons 1 (list 2))) 2)
(check "lazy list" (let ((ones (let loop () (lcons 1 (loop))))) (list (car ones) (car (cdr ones)) (car (cddr ones)))) '(1 1 1))
(check "future" (force (future (* 6 7))) 42)
(check "future autoforce" (+ 1 (future 2)) 3)
(check "error in promise" (catch-errors (general-error (lambda (e) 'caught)) (force (delay (car 1)))) 'caught)
(check "promise of promise" (force (force (delay (delay 'deep)))) 'deep)
(check "delay type" (is-a? (delay 1) future-obj) #t)
(check "forcible type" (is-a? (delay 1) forcible) #t)
(check "map over promises" (map (lambda (p) (+ p 1)) (list (delay 1) (delay 2))) '(2 3))
(check "sort promises" (map force (sort (list (delay 3) (delay 1) (delay 2)) <)) '(1 2 3))
