;;; Arithmetic: fixnums, their edges, bignums, rationals.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(define mpf most-positive-fixnum)
(define mnf most-negative-fixnum)
(define bits (- %%word-size 2))

(check "word size" (or (= %%word-size 32) (= %%word-size 64)) #t)
(check "most-positive-fixnum" mpf (- (expt 2 (- bits 1)) 1))
(check "most-negative-fixnum" mnf (- (expt 2 (- bits 1))))
(check "mpf is fixnum" (fixnum? mpf) #t)
(check "mnf is fixnum" (fixnum? mnf) #t)
(check "mpf+1 is bignum" (fixnum? (+ mpf 1)) #f)
(check "mpf+1 value" (- (+ mpf 1) 1) mpf)
(check "mnf-1 value" (+ (- mnf 1) 1) mnf)
(check "mnf negated" (- mnf) (+ mpf 1))
(check "mnf quotient -1" (quotient mnf -1) (+ mpf 1))
(check "mnf abs" (abs mnf) (+ mpf 1))
(check "multiply overflow" (* mpf 2) (* 2 mpf))
(check "multiply overflow exact" (quotient (* mpf mpf) mpf) mpf)
(check "ash-left promotes" (ash-left 1 (+ bits 5)) (expt 2 (+ bits 5)))
(check "ash-left small" (ash-left 3 4) 48)
(check "ash-right" (ash-right 48 4) 3)
(check "ash-right negative" (ash-right -1 10) -1)
(check "ash-right big" (ash-right (expt 2 100) 98) 4)
(check "rot-left wraps" (rot-left 1 (- bits 1)) mnf)
(check "bit ops" (list (bit-and 12 10) (bit-or 12 10) (bit-xor 12 10) (bit-not 0)) '(8 14 6 -1))
(check "fact 20" (let loop ((n 20) (a 1)) (if (= n 0) a (loop (- n 1) (* a n)))) 2432902008176640000)
(check "fact 30" (let loop ((n 30) (a 1)) (if (= n 0) a (loop (- n 1) (* a n)))) 265252859812191058636308480000000)
(check "expt 2 100" (expt 2 100) 1267650600228229401496703205376)
(check "big print/read" (read (make string-input-stream (format #f "~D" (expt 3 80)))) (expt 3 80))
(check "big negative" (- (expt 2 70)) (* -1 (expt 2 70)))
(check "big quotient" (quotient (expt 10 30) (expt 10 20)) (expt 10 10))
(check "big remainder" (remainder (+ (expt 10 30) 7) (expt 10 20)) 7)
(check "big modulo negative" (modulo (- (expt 10 30)) 7) (modulo (- (expt 10 30)) 7))
(check "big = " (= (expt 2 64) (* (expt 2 32) (expt 2 32))) #t)
(check "big <" (< (expt 2 64) (expt 2 65)) #t)
(check "gcd" (gcd 12 18 30) 6)
(check "gcd none" (gcd) 0)
(check "lcm" (lcm 4 6) 12)
(check "rational" (+ 1/3 1/6) 1/2)
(check "rational normalize" (* 2/4 2) 1)
(check "numerator" (numerator 6/4) 3)
(check "denominator" (denominator 6/4) 2)
(check "floor" (floor 7/2) 3)
(check "ceiling" (ceiling 7/2) 4)
(check "round" (round 7/2) 4)
(check "truncate" (truncate -7/2) -3)
(check "min max" (list (min 3 1 2) (max 3 1 2)) '(1 3))
(check "comparisons" (list (< 1 2) (> 1 2) (<= 2 2) (>= 1 2) (= 2 2) (!= 2 2)) '(#t () #t () #t ()))
(check "predicates" (list (zero? 0) (positive? -1) (negative? -1) (odd? 3) (even? 3)) '(#t () #t #t ()))
(check "div 0 traps" (catch-errors (general-error (lambda (e) 'caught)) (let ((z 0)) (quotient 1 z))) 'caught)
(check "print radix" (bind ((#*print-radix 16)) (format #f "~S" 255)) "FF")
(check "format hex" (format #f "~X" 255) "FF")
(check "format binary" (format #f "~B" 5) "101")
(check "print negative" (format #f "~D" -1234567890) "-1234567890")
(check "print ten digits" (format #f "~D" 1234567890) "1234567890")
(check "print mpf" (read (make string-input-stream (format #f "~D" mpf))) mpf)
