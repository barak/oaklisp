;;; Bignum arithmetic against results computed independently (by
;;; Python, see the generator in the comment at the end).  Exercises
;;; both bases: digits in base 10^4 (32-bit) and 10^9 (64-bit),
;;; sizes from fixnums through the base boundaries to sixty digits.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))
(set! #*print-length #f)
(set! #*print-level #f)

