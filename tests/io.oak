;;; Streams, format, reading and printing, files.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(define nl (#^string (list #\newline)))

(check "format ~A ~S" (format #f "~A ~S" "x" "x") "x \"x\"")
(check "format ~D ~%" (format #f "~D~%" 42) (append "42" nl))
(check "format list" (format #f "~S" '(1 "two" #\3 four)) "(1 \"two\" #\\3 FOUR)")
(check "format ~& fresh" (format #f "a~&b") (append "a" nl "b"))
(check "format ~~" (format #f "~~") "~")
(check "string output stream" (let ((s (make string-output-stream))) (write-string "abc" s) (write-char s #\d) (#^string s)) "abcd")
(check "string input stream read" (read (make string-input-stream "(a (b) \"c\" 4 #\\d)")) '(a (b) "c" 4 #\d))
(check "read-char peek-char" (let ((s (make string-input-stream "xy"))) (list (peek-char s) (read-char s) (read-char s) (eq? (read-char s) the-eof-token))) '(#\x #\x #\y #t))
(check "unread-char" (let ((s (make string-input-stream "xy"))) (let ((c (read-char s))) (unread-char s c) (read-char s))) #\x)
(check "read symbols" (read (make string-input-stream "foo |Bar| a\\ b")) 'foo)
(check "read escaped symbol" (#^string (read (make string-input-stream "|Bar|"))) "Bar")
(check "read numbers" (read (make string-input-stream "(1 -2 #x10 #b101 3/4 1000000000000)")) '(1 -2 16 5 3/4 1000000000000))
(check "read chars" (read (make string-input-stream "(#\\a #\\Space #\\Newline)")) (list #\a #\space #\newline))
(check "read quote" (read (make string-input-stream "'x")) ''x)
(check "read backquote" (read (make string-input-stream "`(a ,b ,@c)")) '(quasiquote (a (unquote b) (unquote-splicing c))))
(check "read vector" (read (make string-input-stream "#(1 2)")) #(1 2))
(check "read dotted" (read (make string-input-stream "(1 . 2)")) '(1 . 2))
(check "read comment" (read (make string-input-stream (append "; c" nl " 5"))) 5)
(check "read block comment" (read (make string-input-stream "#| x |# 6")) 6)
(check "read eof" (eq? (read (make string-input-stream "")) the-eof-token) #t)
(check "print roundtrip" (let ((x '(a "b\"c" #\d 1/2 (e . f) #(g) |h i|))) (equal? (read (make string-input-stream (format #f "~S" x))) x)) #t)
(check "print level" (bind ((#*print-level 1)) (format #f "~S" '(a (b (c))))) "(A #)")
(check "print length" (bind ((#*print-length 2)) (format #f "~S" '(1 2 3 4))) "(1 2 ...)")
(check "print escape off" (let ((s (make string-output-stream))) (bind ((#*print-escape #f)) (print "s" s)) (#^string s)) "s")
(check "newline freshline" (let ((s (make string-output-stream))) (write-string "a" s) (freshline s) (freshline s) (#^string s)) (append "a" nl))

;;; Files, in the current directory (the test script cds to a scratch dir).
(define fname "oaklisp-io-test.tmp")
(write-file fname '(hello (world) 42))
(check "write-file read-file" (read-file fname) '((hello (world) 42)))
(check "with-open-file out/in" (block (with-open-file (s fname out) (format s "line one~%line two~%"))
				      (with-open-file (s fname in) (list (read s) (read s) (read s) (read s)))) '(line one line two))
(check "dofile" (let ((n 0)) (dofile fname (lambda (x) (set! n (+ n 1)))) n) 4)
(check "rename-file" (block (rename-file fname "oaklisp-io-test2.tmp") (list (catch-errors (error-opening-read) (with-open-file (s fname in) 'still-there))
									     (with-open-file (s "oaklisp-io-test2.tmp" in) (read s)))) '(() line))
(check "rename-file failure" (rename-file "oaklisp-no-such-file.tmp" "x.tmp") #f)
(check "error-opening" (catch-errors (error-opening (lambda (e) 'nofile)) (with-open-file (s "oaklisp-no-such-file.tmp" in) 'opened)) 'nofile)
(check "append mode" (block (with-open-file (s "oaklisp-io-test2.tmp" append) (format s "more~%")) (length (read-file "oaklisp-io-test2.tmp"))) 5)
(check "interactive?" (interactive? standard-input) #f)
