;;; Checks for the natively compiled native-me.oak; see native.test.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(check "deep recursion" (count-up 1000000) 1000000)
(check "tail recursion" (loop-down 3000000 0) 3000000)
(check "fib" (fib 25) 75025)
(check "tak" (tak 18 12 6) 7)
(check "iterate" (sum-to 100000) 5000050000)
(check "list walk" (my-length (make-list-n 200000)) 200000)
(check "fixnum overflow" (add most-positive-fixnum 1) (+ most-positive-fixnum 1))
(check "bignum add" (add (expt 2 70) 1) (+ 1 (expt 2 70)))
(check "bignum sub" (sub (- (expt 2 70)) 1) (- -1 (expt 2 70)))
(check "rational add" (add 1/2 1/3) 5/6)
(check "bignum compare" (less? (expt 2 70) (expt 2 71)) #t)
(check "bignum =" (same? (expt 2 70) (expt 2 70)) #t)
(check "call/cc escape" (callcc-test 10000) 'escaped)
(check "two args" (two-args 1 2) '(1 2))
(check "global" (block (bump!) (bump!)) 2)
(check "closure (bytecode) calling native" ((closure-maker 3) 4) 7)
(check "constants" (constants)
       (list "a string" 'a-symbol '(1 2 (3 4)) #\c 1000000000000 -5 #t '()))
(check "bytecode block" (fact 30) 265252859812191058636308480000000)
(check "car error" (catch-errors (general-error (lambda (e) 'caught)) (my-car 5)) 'caught)
(check "nargs error" (catch-errors (general-error (lambda (e) 'caught)) (two-args 1)) 'caught)
(check "gc" (let ((l (make-list-n 100000))) (%gc) (my-length l)) 100000)
(check "deep recursion after gc" (count-up 500000) 500000)
