;;; Control: catch/throw, errors, unwind protection, fluids,
;;; continuations, iteration, green threads.

(define (check name got expected)
  (if (equal? got expected)
      (format #t "PASS ~A~%" name)
      (format #t "FAIL ~A: got ~S expected ~S~%" name got expected))
  (flush standard-output))

;;; LOAD binds these to abbreviate its progress reports; not wanted here.
(set! #*print-length #f)
(set! #*print-level #f)

(check "catch" (catch tag (+ 1 (tag 42))) 42)
(check "native-catch throw" (native-catch tag (+ 1 (throw tag 42))) 42)
(check "catch normal exit" (catch tag (+ 1 2)) 3)
(check "nested catch" (catch a (catch b (a 1)) 2) 1)
(check "wind-protect after" (let ((log '())) (catch tag (wind-protect (set! log (cons 'before log)) (tag 0) (set! log (cons 'after log)))) log) '(after before))
(check "error caught" (catch-errors (general-error (lambda (e) 'caught)) (error "boom")) 'caught)
(check "catch-errors value" (catch-errors (general-error) (car 1) 'other) 'other)
(check "bind-error-handler" (native-catch tag (bind-error-handler (general-error (lambda (e) (throw tag 'handled))) (error "x"))) 'handled)
(check "cerror proceed" (bind-error-handler (proceedable-error (lambda (e) (proceed e 'proceeded))) (cerror "Return proceeded." "test")) 'proceeded)
(check "nested handlers" (catch-errors (general-error (lambda (e) 'outer)) (catch-errors (read-error (lambda (e) 'inner)) (error "not a read error"))) 'outer)
(check "fluid bind" (let () (set! #*testfluid 1) (list (bind ((#*testfluid 2)) #*testfluid) #*testfluid)) '(2 1))
(check "fluid unwound by throw" (let () (set! #*testfluid2 1) (catch tag (bind ((#*testfluid2 2)) (tag 0))) #*testfluid2) 1)
(check "call/cc escape" (+ 1 (call/cc (lambda (k) (k 10) 20))) 11)
(check "call/cc reentry" (let ((k #f) (n 0)) (call/cc (lambda (c) (set! k c))) (set! n (+ n 1)) (if (< n 3) (k 'again)) n) 3)
(check "iterate" (iterate loop ((i 0) (a '())) (if (= i 3) (reverse a) (loop (+ i 1) (cons i a)))) '(0 1 2))
(check "named let" (let loop ((i 0)) (if (< i 10) (loop (+ i 1)) i)) 10)
(check "labels" (labels ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1))))) (od? (lambda (n) (if (= n 0) #f (ev? (- n 1)))))) (ev? 100)) #t)
(check "dotimes" (let ((s 0)) (dotimes (i 5) (set! s (+ s i))) s) 10)
(check "dolist" (let ((s 0)) (dolist (x '(1 2 3)) (set! s (+ s x))) s) 6)
(check "do" (do ((i 0 (+ i 1)) (a '() (cons i a))) ((= i 3) a)) '(2 1 0))
(check "while" (let ((i 0)) (while (< i 5) (set! i (+ i 1))) i) 5)
(check "cond =>" (cond ((assq 'b '((a . 1) (b . 2))) => cdr) (else 'no)) 2)
(check "case" (case 3 ((1 2) 'low) ((3 4) 'mid) (else 'high)) 'mid)
(check "and or" (list (and 1 2) (and 1 #f 3) (or #f 2) (or #f #f)) '(2 () 2 ()))
(check "apply" (apply + 1 2 '(3 4)) 10)
(check "rest args listify" (let ((f (lambda (a . rest) (listify-args (lambda (l) (cons a l)) . rest)))) (f 1 2 3)) '(1 2 3))
(check "rest-length" (let ((f (lambda (a . rest) (consume-args (rest-length rest) . rest)))) (f 1 2 3)) 2)
(check "consume-args" (let ((f (lambda (a . rest) (consume-args a . rest)))) (f 1 2 3)) 1)
(check "deep recursion" (let loop ((n 100000) (a 0)) (if (= n 0) a (loop (- n 1) (+ a 1)))) 100000)
(check "non-tail recursion" (let count ((n 20000)) (if (= n 0) 0 (+ 1 (count (- n 1))))) 20000)
(check "future (green thread)" (force (future (+ 1 2))) 3)
(check "futures with mutex" (let ((m (make mutex)) (r '()))
			      (let ((f1 (future (block (acquire-mutex m) (set! r (cons 1 r)) (release-mutex m) 1)))
				    (f2 (future (block (acquire-mutex m) (set! r (cons 2 r)) (release-mutex m) 2))))
				(+ (force f1) (force f2)))) 3)
(check "gc survives" (let loop ((n 300000) (l '())) (if (= n 0) (length (head l 5)) (loop (- n 1) (cons n (if (> (length l) 100) '() l))))) 5)
(check "big vector gc" (let ((v (make simple-vector 200000))) (dotimes (i 200000) (set! (nth v i) (list i))) (%gc) (car (nth v 199999))) 199999)
