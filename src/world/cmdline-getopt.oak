;;; This can be made more sophisticated later, with command completion etc.
;;; For now is is quite rudimentary.

(define (getopt options args)
  (let aux ((args args))
    (if (null? args)
	'()
	(cond ((strip-dashes (car args))
	       => (lambda (a)
		    (cond ((ass equal? a options)
			   => (lambda (o)
				(let ((n (cadr o))
				      (f (caddr o)))
				  (let ((stuff (head (cdr args) n)))
				    (catch-errors (general-error
						   (lambda (err)
						     ;; Remember that this
						     ;; run did not do what
						     ;; it was asked, so it
						     ;; does not exit 0 and
						     ;; leave a make rule
						     ;; linking whatever
						     ;; stale object the
						     ;; failed --compile
						     ;; left behind.
						     (set! command-line-failures
							   (+ command-line-failures 1))
						     (format standard-error
							     "~&An error occurred while processing switch ~A args ~S~%"
							     a stuff)
						     ;; Reporting the error can
						     ;; itself signal, since it
						     ;; prints the offending
						     ;; object and that object
						     ;; may be the half
						     ;; initialized thing whose
						     ;; INITIALIZE just failed.
						     ;; Contain that here: a
						     ;; switch that cannot even
						     ;; be described must not
						     ;; stop the switches after
						     ;; it from being processed.
						     (catch-errors
						      (general-error
						       (lambda (err2)
							 (format standard-error
								 "~&(this error could not be reported)~%")))
						      (report err standard-error)
						      (format standard-error "~%"))))
						  (apply f stuff)))
				  (aux (tail (cdr args) n)))))
			  (else (format standard-error  "~&error: unknown switch: ~A" a)
				(exit 1)))))
	      (else args)))))

(define (strip-dashes a)
  (let ((n (length a)))
    (and (> n 1)
	 (equal? (nth a 0) #\-)
	 (let ((dashlen (if (equal? (nth a 1) #\-) 2 1)))
	   (and (> n dashlen)
		(subseq a dashlen (- n dashlen)))))))
