;;; This defines the main interface for loading files, LOAD, which
;;; loads the most processed version of the file it can find, unless given
;;; an explicit extension.  Can also be given an explicit locale as an
;;; optional second argument.

(let* ((load-with-ext
	;; Return file if found and loaded, #f or error if not found
	;; depending on not-found-okay.
	(lambda (file ext locale not-found-okay)

	  (let ((op (cond ((equal? ext ".oak") load-oak-file)
			  ((equal? ext ".omac") load-omac-file)
			  ;;((equal? ext ".ou") ...)
			  ;;((equal? ext ".oc") ...)
			  ((equal? ext ".oa") load-oa-file)
			  (else (error "File type ~S unloadable.~%" ext)))))

	    (if not-found-okay
		(catch-errors (error-opening-read)
		  (op locale file)
		  ext)
		(block
		  (op locale file)
		  ext)))))

       (load-aux
	(lambda (args)
	  (destructure (file . args) args
	    (let ((locale (cond ((null? args) #*current-locale)
				(else
				 (when (cdr args)
				   (cerror "Ignore the extra arguments."
					   "Extra args to load: ~S."
					   (cdr args)))
				 (car args)))))

	      (cond ((file-extension file)
		     =>
		     (lambda (ext)
		       (load-with-ext (file-base file) ext locale #f)))

		    ;; Try lots of different filetypes.
		    ((any? (lambda (ext)
			     (load-with-ext file ext locale #t))
			   '(".oa" ".oak" ".omac"))
		     =>
		     (lambda (ext)
		       (format #t "~&Loaded ~A~A.~%" file ext)))
		    (else
		     (error "No loadable file ~S found.~%" file))))))))


  (define (load file . args)
    (listify-args load-aux
		  ((if (symbol? file) downcase identity)
		   (#^string file))
		  . args)))




;;; These utility functions belong elsewhere:

;;; This includes the "." as part of the extension.

(define (file-extension file)
  (let ((len (length file)))
    (iterate aux ((i (- len 1)))
      (if (= i -1) #f
	  (let ((c (nth file i)))
	    (cond ((eq? c #\.) (tail file i))
		  ((eq? c #\/) #f)
		  (else (aux (- i 1)))))))))

(define (file-base file)
  (cond ((file-extension file)
	 => (lambda (ext)
	      (head file (- (length file) (length ext)))))
	(else file)))

;;;



;;; Load compiled bytecode, after any native modules the header
;;; names, which have to be in place before the code that calls them
;;; runs.

(define (load-oa-file locale file)
  (load-code-segment
   locale
   (with-open-file (s (append file ".oa") in)
     (for-each (lambda (module)
		 (load-native-module (native-module-path file module)))
	       (check-bytecode-header s (append file ".oa")))
     (let ((segment (make-oa-list (read-oaf-list s))))
       ;; The object has to be the whole file.  A truncation that
       ;; happened to land where every bracket was already closed would
       ;; otherwise load a prefix of the definitions and report success.
       (skip-whitespace s)
       (unless (eq? the-eof-token (peek-char s))
	 (error "Garbage after the object in ~A.oa." file))
       segment))))

;;; Read the ";oaklisp-bytecode ..." header line, if any, at the start
;;; of a .oa file, and complain if it is for an incompatible
;;; architecture.  Files without a header are legacy files, assumed
;;; to be compatible.  Return the native modules named by
;;; ";oaklisp-native ..." lines.  Other leading comment lines are
;;; skipped.

(define (check-bytecode-header stream name)
  (iterate aux ((modules '()))
    (skip-whitespace stream)
    (cond ((eq? (peek-char stream) #\;)
	   (let ((line (read-comment-line stream)))
	     (cond ((parse-bytecode-header line)
		    => (lambda (arch)
			 (unless (bytecode-compatible? arch host-architecture)
			   (error "~A was compiled for architecture ~A, incompatible with this ~A system."
				  name
				  (bytecode-architecture-name arch)
				  (architecture-name host-architecture)))
			 (aux modules)))
		   ((parse-native-header line)
		    => (lambda (module) (aux (cons module modules))))
		   (else (aux modules)))))
	  (else (reverse! modules)))))

;;; A native module is named relative to the directory of the .oa
;;; file naming it.

(define (native-module-path file module)
  (if (eq? (nth module 0) #\/)
      module
      (iterate aux ((i (- (length file) 1)))
	(cond ((= i -1) module)
	      ((eq? (nth file i) #\/) (append (head file (+ i 1)) module))
	      (else (aux (- i 1)))))))

;;; An executable built by oakc (see oakc.in at the top level) carries
;;; the .oa texts of its files in memory; %EMBEDDED-PROGRAM-CHAR hands
;;; them out a character at a time, and the --load-embedded switch in
;;; its built-in command line loads them here.  The native modules were
;;; registered before boot, so the ";oaklisp-native" header lines are
;;; skipped along with the rest.

(define-instance embedded-program-stream type '(index) (list input-stream object))

(add-method (initialize (embedded-program-stream index) self)
  (set! index 0)
  self)

(add-method (really-read-char (embedded-program-stream index) self)
  (let ((c (%embedded-program-char index)))
    (if (null? c)
	the-eof-token
	(block (set! index (+ index 1))
	       c))))

(define (load-embedded-program)
  (let ((s (make embedded-program-stream)))
    (iterate aux ()
      (skip-whitespace s)
      (cond ((eq? (peek-char s) the-eof-token) 'loaded)
	    ((eq? (peek-char s) #\;)
	     (read-comment-line s)
	     (aux))
	    (else
	     (load-code-segment #*current-locale
				(make-oa-list (read-oaf-list s)))
	     (aux))))))

;;; A straight-C executable (oakc) carries no .oa text at all: at
;;; build time BAKE-FILE links each compiled file into the world
;;; without running it, collecting one operation per file, and the
;;; world is then dumped into the executable.  At run time its built-in
;;; command line calls RUN-BAKED-PROGRAM, which runs them in order.

(define *baked-program* '())

(define (bake-file the-locale file)
  (let ((seg (with-open-file (s (append file ".oa") in)
	       ;; The header lines are for the dynamic loader; the
	       ;; executable's modules are linked in, so skip them.
	       (iterate aux ()
		 (skip-whitespace s)
		 (when (eq? (peek-char s) #\;)
		   (read-comment-line s)
		   (aux)))
	       (make-oa-list (read-oaf-list s)))))
    (bind ((#*current-locale the-locale))
      (set! *baked-program*
	    (append *baked-program*
		    (list (%install-method-with-env
			   object
			   (make operation)
			   (link-code-segment the-locale seg)
			   %empty-environment)))))
    'baked))

(define (run-baked-program)
  (dolist (op *baked-program*)
    (op)))

;;; Dead code removal for a baked executable (oakc --strip,
;;; CompilerPlan.md milestone 5): the locale tables are what keep every
;;; global alive, so emptying them lets the pre-dump GC drop everything
;;; the program, the boot path and the trap tables do not reach.  KEEP
;;; names the globals the executable's command line still looks up
;;; (RUN-BAKED-PROGRAM and whatever its --eval forms mention).  A
;;; stripped world cannot look anything else up by name: EVAL of new
;;; code, APROPOS and friends are gone, which is why this is opt-in and
;;; refused alongside --interpreter.

(define-instance %strip-locale operation)

(add-method (%strip-locale (locale variable-table frozen-symbols macro-alist)
			   self keep)
  (let ((new (make-eq-hash-table)))
    (dolist (sym keep)
      (let ((cell (table-entry variable-table sym)))
	(when cell
	  (set! (table-entry new sym) cell))))
    (set! variable-table new)
    (set! frozen-symbols '())
    (set! macro-alist '())
    self))

(define (strip-locales keep)
  (dolist (loc (list system-locale compiler-locale scheme-locale
		     user-locale oaklisp-locale))
    (%strip-locale loc keep)))

;;; Link-time method resolution for whole-program executables (oakc
;;; --whole-program, CompilerPlan.md milestone 5): the generated
;;; prelude binds the methods, types and bp offsets that statically
;;; resolved call sites read through cells.  The search mirrors the
;;; emulator's FIND-METHOD-TYPE-PAIR: the type's own alist, then the
;;; supertypes, depth first and left to right.

(define (%find-method-entry typ op)
  (let ((hit (%assq op (%get-an-ivar type typ 'operation-method-alist))))
    (if hit
	(cons (cdr hit) typ)
	(iterate aux ((supers (%get-an-ivar type typ 'supertype-list)))
	  (cond ((null? supers) #f)
		((%find-method-entry (car supers) op))
		(else (aux (cdr supers))))))))

(define (%method-for op typ)
  (let ((hit (%find-method-entry typ op)))
    (if hit
	(car hit)
	(error "No method for ~S on ~S at link time." op typ))))

(define (%bp-offset-for op typ)
  (let* ((hit (%find-method-entry typ op))
	 (x (and hit (%assq (cdr hit) (get-bp-alist typ)))))
    (if x (cdr x) 0)))

;;; Load the shared object holding natively compiled code (see
;;; native-compiler.oak).  When bootstrapping from an older world the
;;; Makefile loads the freshly compiled streams.oa before compiling
;;; this file, so that %STREAM-PRIMITIVE knows number 15.

(define (load-native-module file)
  (let ((file (#^string file)))
    (unless ((%stream-primitive 15) (make-locative (%vref file 0))
				    (length file))
      (error "Unable to load native module ~A." file))))

(define (read-comment-line stream)
  (iterate aux ((chars '()))
    (let ((c (read-char stream)))
      (if (or (eq? c the-eof-token) (eq? c #\newline))
	  (#^string (reverse! chars))
	  (aux (cons c chars))))))


#||
(define (load-oa-file locale file)
  (load-code-segment
   locale
   (with-open-file (s (append (#^string file) ".oa") in)
      (let ((red (read s)))
	(if (and (pair? (car red))
		 (pair? (caar red)))
	    red
	    (make-oa-list red))))))

(define (load-oa-file locale file)
  (load-code-segment locale
		     (let ((s (open-input-file (append (#^string file) ".oa"))))
		       (block0 (read s) (close s)))))

(define (load-oak-file locale file)
  (bind ((#*current-locale locale)
	 (#*print-length 3)
	 (#*print-level 2))
    (dofile (append file ".oak")
	    (lambda (expr)
	      (format #t "~A...~%" expr)
	      (eval expr locale)))))

||#



;;; Load source, a form at a time: expand in a sub-locale holding
;;; the file's own local syntax, then evaluate in the real one.  The
;;; forms are echoed as they go by, since this is slow.

(define (load-oak-file the-locale file-name)
  (let* ((raw-forms (read-file (append file-name ".oak")))
	 (sub-locale (make locale (list the-locale))))

    (bind ((#*current-locale the-locale)
	   (#*print-length 3)
	   (#*print-level 2))

      (dolist (raw-form raw-forms)

	(format #t "~A...~%" raw-form)

	(let ((expanded-form
	       (bind ((#*current-locale sub-locale))
		 (expand-groveling sub-locale raw-form))))
	  (subeval expanded-form the-locale))))

    'loaded))




;;; Load a file of macro definitions, evaluated rather than
;;; compiled.

(define (load-omac-file locale file)
  (dofile (append file ".omac")
	  (lambda (expr) (subeval expr locale))))

