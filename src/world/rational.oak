;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;
;;; Define the FRACTION type, which consists of those rationals that
;;; are not integers.

(define-instance fraction type
  '(the-numerator the-denominator) (list rational object))

(add-method (initialize (fraction the-numerator the-denominator) self top bot)
  (set! the-numerator top)
  (set! the-denominator bot)
  self)

;;; This controls whether fractions are printed 7/3, 2⋅1/3, or 2.333333.
;;;
;;; Possible values: NORMAL, FANCY, and FLOAT for regular (potentially
;;; improper) fractions, proper ones, and decimal series.

(set! #*fraction-display-style 'normal)

;;; This controls how many digits past the decimal point are printed in
;;; FLOAT mode.
(set! #*float-digits 10)

(add-method (print (fraction the-numerator the-denominator) self stream)
  (case #*fraction-display-style

    ((normal)
     (format stream "~A/~A" the-numerator the-denominator))

    ((fancy)
     (let ((num (cond ((negative? the-numerator)
		       (format stream "-")
		       (- the-numerator))
		      (else the-numerator))))
       (cond ((< num the-denominator)
	      (format stream "~A/~A" num the-denominator))
	     (else
	      (let* ((y (quotient num the-denominator))
		     (z (- num (* y the-denominator))))
		(format stream "~A⋅~A/~A" y z the-denominator))))))

    ((float)
     (labels (((pos x)
	       (let* ((y (truncate x))
		      (radix #*print-radix))
		 (format stream "~D." y)
		 (iterate aux ((x (- x y))
			       (digits #*float-digits))
		   (cond ((or (zero? x) (zero? digits)) #f)
			 (else
			  (let* ((x (* x radix))
				 (y (truncate x)))
			    (format stream "~D" y)
			    (aux (- x y) (- digits 1)))))))))
       (cond ((negative? the-numerator)
	      (format stream "-")
	      (pos (- self)))
	     (else (pos self)))))

    (else
     (error "Unknown fraction printing style ~S." #*fraction-display-style))))


(add-method (plus/2 (fraction (xnum the-numerator) (xden the-denominator)) x
		    (fraction (ynum the-numerator) (yden the-denominator)) y)
  (fx/ (+ (* xnum yden) (* ynum xden))
       (* xden yden)))

(add-method (plus/2 (fraction the-numerator the-denominator) x (rational) y)
  (let ((numy (numerator y))
	(deny (denominator y)))
    (fx/ (+ (* the-numerator deny) (* numy the-denominator))
	 (* the-denominator deny))))

(add-method (plus/2 (fraction) x (complex) y) (plus/2 y x))

(add-method (plus/2 (fraction) x y)
  (error "Illegal second arg: (%PLUS ~A ~A)~%" x y))

(add-method (times/2 (fraction (xnum the-numerator) (xden the-denominator)) x
		     (fraction (ynum the-numerator) (yden the-denominator)) y)
  (fx/ (* xnum ynum) (* xden yden)))

(add-method (times/2 (fraction the-numerator the-denominator) x (rational) y)
  (fx/ (* the-numerator (numerator y))
       (* the-denominator (denominator y))))

(add-method (times/2 (fraction) x (complex) y) (times/2 y x))

(add-method (times/2 (fraction) x y)
  (error "Illegal second arg: (%TIMES ~A ~A)" x y))


(add-method (/ (rational) x (rational) y)
  (fx/ (* (numerator x) (denominator y))
       (* (denominator x) (numerator y))))

(add-method (/ (rational) x (complex) y) (/r y x))

(add-method (/ (rational) x y)
  (error "Illegal second arg: (/ ~A ~A)" x y))

(add-method (/r (rational) x (integer) y)
  (fx/ (* (denominator x) y)
       (numerator x)))

(add-method (/r (rational) x (rational) y)
  (fx/ (* (denominator x) (numerator y))
       (* (numerator x) (denominator y))))

(add-method (/r (rational) x y)
  (error "Illegal second arg: (/ ~A ~A)" x y))

(add-method (minus (fraction the-numerator the-denominator) self)
  ;; Make the fraction directly, since no normalization will be needed.
  (make fraction (- the-numerator) the-denominator))

(add-method (subtract/2 (fraction the-numerator the-denominator) x
			(rational) y)
  (let ((numy (numerator y))
	(deny (denominator y)))
    (fx/ (- (* the-numerator deny) (* numy the-denominator))
	 (* the-denominator deny))))

(add-method (subtract/2 (fraction) x y)
  (^super number subtract/2 x y))

;;;;;;;;;;;;;;;;;;;;;
;;; Comparison
;;;;;;;;;;;;;;;;;;;;;

(add-method (= (fraction (xnum the-numerator) (xden the-denominator)) x
	       (fraction (ynum the-numerator) (yden the-denominator)) y)
  (and (= xnum ynum) (= xden yden)))

(add-method (= (fraction) x (number) y) #f)

(add-method (= (fraction) x y)
  (error "Illegal second arg (= ~D ~D)." x y))


;;; EQUAL? on fractions is the method above, so it compares values while
;;; the default HASH-KEY compares identity; without this an
;;; EQUAL-HASH-TABLE keyed on fractions never finds its own entries.
;;; See the comment on HASH-KEY in hash-table.oak.  Fractions are kept
;;; in lowest terms with a positive denominator, so equal values always
;;; present the same pair of components here.

(add-method (hash-key (fraction the-numerator the-denominator) self)
  (bit-xor (rot-left (hash-key the-numerator) 13)
	   (hash-key the-denominator)))

;;; A fraction as the second argument of a fixnum comparison.  This
;;; was a clause of an FSELECT-TYPE in numbers.oak, which had to name
;;; RATIONAL's only non-integer subtype before there was one.

(add-method (< (fixnum) x (rational) y)
  (< (* x (denominator y)) (numerator y)))

(add-method (< (fraction the-numerator the-denominator) x (rational) y)
  (< (* the-numerator (denominator y))
     (* (numerator y) the-denominator)))

(add-method (< (fraction) x y)
  (error "Illegal second arg (< ~D ~D)." x y))

;;; For speed:

(add-method (negative? (fraction the-numerator) x)
  (negative? the-numerator))

(add-method (positive? (fraction the-numerator) x)
  (positive? the-numerator))

;;;;;;;;;;;;;;;;;;;;;;

(add-method (abs (fraction the-numerator the-denominator) self)
  (if (negative? the-numerator)
      ;; Sure to be no normalization, so make the fraction directly.
      (make fraction (- the-numerator) the-denominator)
      self))

#||
(add-method (sqrt (fraction the-numerator the-denominator) self)
  (/ (sqrt the-numerator)
     (sqrt the-denominator)))
||#

(define-instance numerator operation)
(define-instance denominator operation)

(add-method (numerator (fraction the-numerator) self)
  the-numerator)

(add-method (denominator (fraction the-denominator) self)
  the-denominator)

(add-method (numerator (integer) self) self)
(add-method (denominator (integer) self) 1)

;;;;;;;;;;;;

(define (fx/ top bot)
  (labels (((aux top bot neg?)
	    (if (= bot 1)
		(if neg? (- top) top)
		(let ((d (gcd/2 top bot)))
		  (if (= d bot)
		      (quotient (if neg? (- top) top) bot)
		      (make fraction
			    (quotient (if neg? (- top) top) d)
			    (quotient bot d)))))))
    (cond ((zero? bot)
	   (error "Division by zero: (FX/ ~D ~D)." top bot))
	  ((zero? top)
	   0)
	  ((negative? top)
	   (if (negative? bot)
	       (aux (- top) (- bot) #f)
	       (aux (- top) bot #t)))
	  (else
	   (if (negative? bot)
	       (aux top (- bot) #t)
	       (aux top bot #f))))))

;;; The subtractive loop only terminates when both arguments are
;;; non-negative: with a = 1 and b = -7 the second clause computes
;;; p = 0, which is not b, and recurs on exactly the same pair.  So the
;;; magnitudes are taken by the callers below rather than here, and this
;;; binary core stays the fast path FX/ uses on every rational it
;;; builds.  Zero is handled up front; the old code divided by it.

(define (gcd/2 a b)
  (iterate gcd ((a a)(b b))
    (cond ((zero? a) b)
	  ((zero? b) a)
	  ((< a b) (let ((p (* a (quotient b a))))
		     (if (= p b) a
			 (gcd (- b p) a))))
	  ((> a b) (let ((p (* b (quotient a b))))
		     (if (= p a) b
			 (gcd (- a p) b))))
	  (else a))))

;;; R3RS gives both of these any number of arguments -- (gcd) is 0 and
;;; (lcm) is 1 -- and requires a non-negative result, so (gcd 32 -36)
;;; is 4 rather than a hang.

(define (gcd . args)
  (listify-args
   (lambda (args)
     (iterate step ((args args) (g 0))
       (if (null? args)
	   g
	   (step (cdr args) (gcd/2 g (abs (car args)))))))
   . args))

(define (lcm . args)
  (listify-args lcm-of-list . args))

(define (lcm-of-list args)
  (iterate step ((args args) (l 1))
    (if (null? args)
	l
	(let ((n (abs (car args))))
	  (if (zero? n)
	      0
	      (step (cdr args) (quotient (* l n) (gcd/2 l n))))))))

