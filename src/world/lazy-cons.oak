(define-instance lazy-cons type
  '(car-thunk cdr-thunk car-flag cdr-flag) (list pair object))

(add-method (initialize (lazy-cons car-thunk cdr-thunk car-flag cdr-flag)
			    self new-car-thunk new-cdr-thunk)
  (set! car-thunk new-car-thunk)
  (set! cdr-thunk new-cdr-thunk)
  (set! car-flag nil)
  (set! cdr-flag nil)
  self)

(add-method (car (lazy-cons car-thunk car-flag) self)
  (if car-flag car-thunk
      (let ((newcar (car-thunk)))
	;; Critical section; would be a good idea to disable interrupts.
	(set! car-flag #t)
	(set! car-thunk newcar))))

(add-method (cdr (lazy-cons cdr-thunk cdr-flag) self)
  (if cdr-flag cdr-thunk
      (let ((newcdr (cdr-thunk)))
	;; Critical section; would be a good idea to disable interrupts.
	(set! cdr-flag #t)
	(set! cdr-thunk newcdr))))

(add-method ((setter car) (lazy-cons car-thunk car-flag) self val)
  (set! car-flag #t)
  (set! car-thunk val))

(add-method ((setter cdr) (lazy-cons cdr-thunk cdr-flag) self val)
  (set! cdr-flag #t)
  (set! cdr-thunk val))

(add-method ((locater car) (lazy-cons car-thunk) self)
  (car self)
  (make-locative car-thunk))

(add-method ((locater cdr) (lazy-cons cdr-thunk) self)
  (cdr self)
  (make-locative cdr-thunk))

(define-syntax (lcons a d)
  `(make lazy-cons (lambda () ,a) (lambda () ,d)))

(define-instance lmap operation)
(define-instance lmap1 operation)
(define-instance lmap2 operation)
(define-instance lmap3 operation)
(define-instance lmap4 operation)
(define-instance lmap5 operation)
(define-instance general-lmap operation)

;;; LMAP takes any number of lists, dispatching on their number the
;;; way MAP does; the result is a lazy list, as long as the first.

(add-method (lmap (operation) op l . args)
  ((cond ((= 0 (rest-length args)) lmap1)
	 ((= 1 (rest-length args)) lmap2)
	 ((= 2 (rest-length args)) lmap3)
	 ((= 3 (rest-length args)) lmap4)
	 ((= 4 (rest-length args)) lmap5)
	 (else general-lmap))
   op l . args))

(add-method (lmap1 (operation) op l)
  (if (null? l) '()
      (lcons (op (car l)) (lmap1 op (cdr l)))))

(add-method (lmap2 (operation) op l1 l2)
  (if (null? l1) '()
      (lcons (op (car l1) (car l2))
	     (lmap2 op (cdr l1) (cdr l2)))))

(add-method (lmap3 (operation) op l1 l2 l3)
  (if (null? l1) '()
      (lcons (op (car l1) (car l2) (car l3))
	     (lmap3 op (cdr l1) (cdr l2) (cdr l3)))))

(add-method (lmap4 (operation) op l1 l2 l3 l4)
  (if (null? l1) '()
      (lcons (op (car l1) (car l2) (car l3) (car l4))
	     (lmap4 op (cdr l1) (cdr l2) (cdr l3) (cdr l4)))))

(add-method (lmap5 (operation) op l1 l2 l3 l4 l5)
  (if (null? l1) '()
      (lcons (op (car l1) (car l2) (car l3) (car l4) (car l5))
	     (lmap5 op (cdr l1) (cdr l2) (cdr l3) (cdr l4) (cdr l5)))))

(labels (((aux args)
	  (destructure (op . args) args
	    (aux1 op args)))

	 ((aux1 op list-of-lists)
	  (if (null? (car list-of-lists)) '()
	      (lcons (apply op (map car list-of-lists))
		     (aux1 op (map cdr list-of-lists))))))

	(add-method (general-lmap (operation) op . lists)
	  (listify-args aux op . lists)))

(define (square-list n)
  (make lazy-cons (lambda () (* n n)) (lambda () (square-list (+ n 1)))))

(define (integer-list n)
  (make lazy-cons (lambda () n) (lambda () (integer-list (+ n 1)))))

(define (fair-merge l1 l2)
  (if (not (null? l1))
      (lcons (car l1)
	     (fair-merge l2 (cdr l1)))
      l2))

;;; This print method isn't really necessary:

(add-method (print (lazy-cons car-thunk cdr-thunk car-flag cdr-flag) self s)

  (let ((f #*forcible-print-magic))

    (cond ((eq? f 'transparent)
	   (^super pair print self s))

	  ((eq? f '#f)

	   (format s "#[LAZY-CONS ~A ~A ~!]"
		   (if car-flag car-thunk "?")
		   (if cdr-flag cdr-thunk "?")
		   self))

	  ((eq? f 'indicate)
	   (format s "#L")
	   (^super pair print self s))

	  (else (error "Unknow (FLUID FORCIBLE-PRINT-MAGIC) option ~S." f)))))

