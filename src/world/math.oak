(define prime-list
  (labels (((prime? n)
	    (iterate aux ((l prime-list))
	      (let* ((i (car l))
		     (n/i (quotient n i)))
		(cond ((< n/i i) #t)
		      ((= (* i n/i) n) #f)
		      (else (aux (cdr l)))))))

	   ((primes-list n)
	    (if (prime? n)
		(lcons n (primes-list (+ 1 n)))
		(primes-list (+ 1 n)))))

    (lcons 2 (primes-list 3))))


;;; Zero and the negatives are dealt with before the loop starts, so
;;; what it sees is always a positive integer.  (QUOTIENT 0 P) is 0 for
;;; every prime, so zero never reaches the (= 1 LEFT) test and used to
;;; spin forever; a negative argument used to come back with its sign
;;; smuggled into the last factor.

(define (factor n)
  (cond ((zero? n)
	 (error "FACTOR of 0, which has no factorization."))
	((negative? n) (cons -1 (factor (- n))))
	(else
	 (iterate step ((left n) (factors '()) (tries prime-list))
	   (let* ((try (car tries))
		  (try-square (* try try)))
	     (cond ((= 1 left) factors)
		   ((zero? (modulo left try))
		    (step (quotient left try) (cons try factors) tries))
		   ((> try-square left)
		    (cons left factors))
		   (else
		    (step left factors (cdr tries)))))))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Square roots.

;;; There are no floats here, so a square root is either exact or it is
;;; an error.  INTEGER-SQRT answers the largest integer whose square is
;;; at most N, which is enough to decide which of the two it is, and to
;;; give ABS of a Gaussian integer an exact value when it has one.
;;; Newton's method converges from above once it is started at or above
;;; the true root, so the initial guess is the smallest power of two
;;; whose square is at least N.

(define-instance integer-sqrt operation)

(add-method (integer-sqrt (integer) n)
  (cond ((negative? n)
	 (error "INTEGER-SQRT of the negative number ~S." n))
	((< n 2) n)
	(else
	 (let ((start (iterate guess ((g 1))
			(if (< n (* g g)) g (guess (+ g g))))))
	   (iterate aux ((x start))
	     (let ((y (quotient (+ x (quotient n x)) 2)))
	       (if (< y x) (aux y) x)))))))

(define-instance sqrt operation)

(define (%inexact-sqrt-error x)
  (error "SQRT of ~S is not exact, and this Oaklisp has no floats." x))

(add-method (sqrt (integer) n)
  (cond ((negative? n) (make-complex 0 (sqrt (- n))))
	(else
	 (let ((r (integer-sqrt n)))
	   (if (= (* r r) n) r (%inexact-sqrt-error n))))))

(add-method (sqrt (fraction the-numerator the-denominator) x)
  (cond ((negative? x) (make-complex 0 (sqrt (- x))))
	(else
	 (let ((rn (integer-sqrt the-numerator))
	       (rd (integer-sqrt the-denominator)))
	   (if (and (= (* rn rn) the-numerator)
		    (= (* rd rd) the-denominator))
	       (/ rn rd)
	       (%inexact-sqrt-error x))))))

;;; For Z = A+Bi with an exact modulus M, the principal square root is
;;; sqrt((M+A)/2) + i*sgn(B)*sqrt((M-A)/2); both halves are exact
;;; whenever the answer is a Gaussian rational, and signal otherwise.

(add-method (sqrt (complex the-real-part the-imag-part) z)
  (let* ((m (abs z))
	 (re (sqrt (/ (+ m the-real-part) 2)))
	 (im (sqrt (/ (- m the-real-part) 2))))
    (make-complex re (if (negative? the-imag-part) (- im) im))))


