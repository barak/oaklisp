;;; This file defines strings.  It uses the ARRAY stuff.

;;; Add in variable-length-mixin and make fancy NTH methods

(initialize string '(char-count) (list simple-vector))

(define-constant %chars-per-word 3)

;;; A string's characters are packed three to a word, low byte first.
;;; When the character count is not a multiple of three the top bytes of
;;; the last word belong to no character at all; they are padding, and
;;; two strings with the same characters must be indistinguishable
;;; whatever happens to be sitting in them.  This answers a mask that
;;; keeps only the bytes N-CHARS actually reaches, and -1 (all ones)
;;; when the last word is full.

(define (%string-last-word-mask n-chars)
  (let ((n-in-last (modulo n-chars %chars-per-word)))
    (if (zero? n-in-last)
	-1
	(- (ash-left 1 (* 8 n-in-last)) 1))))

;;; CHAR? is not defined until predicates.oak, which is loaded long
;;; after this file, so the entry points here that have to reject a
;;; non-character test the type directly.  Every character is an
;;; immediate whose type is CHARACTER itself -- see subtypes.oak, which
;;; installs it as subtype 0 -- so an EQ? on the type is exact.

(define (%char? x) (eq? (get-type x) character))

;;; Try to make only one empty string.  The following works, because the
;;; world builder makes only one empty string.

;;; The fill character is optional, as R3RS MAKE-STRING has it; without
;;; one the string is filled with nulls, which is what this always did.

;;; The last word of a string holds (MODULO LEN %CHARS-PER-WORD)
;;; characters when that is not zero, and the bytes above them are
;;; padding that belongs to no character.  Every constructor in the
;;; system leaves that padding zero, and STRING-GUTS-EQUAL? and
;;; STRING-HASH-KEY both mask it off before they look at it -- see the
;;; comment above the EQUAL? method below.  The fill word is masked here
;;; so this constructor keeps to the same convention: a string filled
;;; with #\a has to come out identical to the same characters spelled
;;; any other way, down to the bits.

(define (make-string len . rest)
  (cond ((negative? len)
	 (error "Cannot make a string of ~D characters." len))
	((zero? len) "")
	(else
	 (let* ((fill-char (if (null? rest) #\NULL (car rest)))
		(byte (if (%char? fill-char)
			  (bit-and #xFF (%character->fixnum fill-char))
			  ;; %CHARACTER->FIXNUM would happily take the
			  ;; data field apart of whatever it was handed.
			  (error "~S is not a character to fill a string with."
				 fill-char)))
		(word (bit-or byte
			      (bit-or (ash-left byte 8)
				      (ash-left byte 16))))
		(word-count
		 (quotient (+ len (- %chars-per-word 1)) %chars-per-word))
		(last-word (bit-and word (%string-last-word-mask len)))
		(s (make string word-count len))
		(loc (make-locative (%vref s 0))))
	   (dotimes (i word-count s)
	     (set! (contents (%increment-locative loc i))
		   (if (= i (- word-count 1)) last-word word)))))))

;;; LEN is both the length the string reports and the bound NTH and
;;; (SETTER NTH) check against, while WORD-COUNT is how many cells were
;;; actually allocated.  A LEN those cells cannot hold would let the
;;; caller read and write past the end of the object, so the two have to
;;; be checked against each other here -- this is the ordinary MAKE
;;; protocol, not a %-prefixed primitive, so the check belongs in it.

(add-method (initialize (string char-count) self word-count len)
  (when (or (negative? len)
	    (> len (* word-count %chars-per-word)))
    (error "Cannot make a string of ~D characters out of ~D words."
	   len word-count))
  (set! char-count len)
  self)

(add-method (length (string char-count) self)
  char-count)



;;;;;;;;;;;;;;;;;

#|
(add-method (nth (string char-count) self n)
  (if (<= char-count n)
      (error "Index ~D into ~S out of bounds." n self)
      (%fixnum->character
       (bit-and #xFF
		(let ((d (modulo n %chars-per-word))
		      (x (%vref self (quotient n %chars-per-word))))
		  (cond ((= d 0) x)
			((= d 1) (ash-left x -8))
			((= d 2) (ash-left x -16))))))))

(add-method ((setter nth) (string char-count) self n new-c)
  (if (<= char-count n)
      (error "Index ~D into ~S out of bounds." n self)
      (let ((m (quotient n %chars-per-word))
	    (i (* (modulo n %chars-per-word) 8)))
	(set! (%vref self m)
	     (bit-or (bit-and (%vref self m)
			      (bit-and #xFFFFFF
				       (bit-not (ash-left #xFF i))))
		     (ash-left (bit-and #xFF (%character->fixnum new-c))
			       i))))))
|#

;;;;;;;;;;;;;;;;;



(add-method (nth (string char-count) self n)
  (if (or (negative? n) (<= char-count n))
      (error "Index ~D into ~S out of bounds." n self)
      (%fixnum->character
       (bit-and #xFF
		(let ((d (modulo n %chars-per-word))
		      (x (%vref-nocheck self (quotient n %chars-per-word))))
		  (cond ((= d 0) x)
			((= d 1) (ash-left x -8))
			((= d 2) (ash-left x -16))))))))



(add-method ((setter nth) (string char-count) self n new-c)
  (cond ((or (negative? n) (<= char-count n))
	 (error "Index ~D into ~S out of bounds." n self))
	;; A string holds characters, and R4RS STRING-SET! requires one.
	;; %CHARACTER->FIXNUM below is (ASH-LEFT (%DATA X) -6), which
	;; takes the data field apart of whatever it is handed, so
	;; without this a fixnum would be stored as a character with an
	;; unrelated code rather than reported.  MAKE-STRING checks its
	;; fill argument the same way.
	((not (%char? new-c))
	 (error "~S is not a character to store into a string." new-c))
	(else
	 (let ((m (quotient n %chars-per-word))
	       (i (* (modulo n %chars-per-word) 8)))
	   ;; The character being deposited is masked to its own byte,
	   ;; not just the hole it goes into.  A character type is wider
	   ;; than a byte -- %FIXNUM->CHARACTER will build one from any
	   ;; fixnum -- and an unmasked code above 255 would shift its
	   ;; high bits straight into the byte belonging to the next
	   ;; character of the same word, silently corrupting a character
	   ;; the caller never wrote to.  NTH masks on the way out, so
	   ;; the damage would show up only at the neighbour.
	   (set! (%vref-nocheck self m)
		 (bit-or (bit-and (%vref-nocheck self m)
				  (bit-and #xFFFFFF
					   (bit-not (ash-left #xFF i))))
			 (ash-left (bit-and #xFF (%character->fixnum new-c))
				   i)))
	   new-c))))



(add-method ((locater nth) (string) self n)
  (error "sorry, (locater nth) doesn't work on strings (e.g. ~a)"
	 self))



;;;;;;;;;;;;;;;;;


(define-instance upcase operation)
(define-instance downcase operation)

(add-method (print (string) self stream)
  (cond (#*print-escape
	 (write-char stream #\")
	 (write-string-with-slashes self #\" stream)
	 (write-char stream #\"))
	(else
	 (write-string self stream))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;



;;; Coerce any kind of sequence to a string.

(add-method (#^string (sequence) seq)
  (let* ((len (length seq))
	 (s (make-string len)))
    (iterate aux ((i 0))
      (cond ((< i len)
	     (set! (nth s i) (nth seq i))
	     (aux (+ i 1)))
	    (else s)))))

;;; The following code coerces only lists to strings, but is highly optimized.
;;; This code packs characters in by threes instead of shifting and or'ing
;;; each one in individually, and avoids the overhead of the nth's.

(let ((fill-string (make operation)))

  (add-method (fill-string (variable-length-mixin) s l len)

    ;; Each code is masked to its own byte for the same reason
    ;; (SETTER NTH) masks: a character whose code exceeds 255 would
    ;; otherwise spill into the byte of the character packed after it.
    (iterate aux ((i 0)(l l)(to-do len))
      (cond ((zero? to-do)
	     s)
	    ((= 1 to-do)
	     (set! (%load-bp-i i)
		   (bit-and #xFF (%character->fixnum (car l))))
	     s)
	    ((= 2 to-do)
	     (set! (%load-bp-i i)
		   (bit-or (bit-and #xFF (%character->fixnum (car l)))
			   (ash-left (bit-and #xFF
					      (%character->fixnum (cadr l)))
				     8)))
	     s)
	    (else
	     (let* ((c0 (bit-and #xFF (%character->fixnum (car l))))
		    (l1 (cdr l))
		    (c1 (bit-and #xFF (%character->fixnum (car l1))))
		    (l2 (cdr l1))
		    (c2 (bit-and #xFF (%character->fixnum (car l2)))))
	       (set! (%load-bp-i i)
		     (bit-or c0 (bit-or (ash-left c1 8) (ash-left c2 16))))
	       (aux (+ i 1) (cdr l2) (- to-do %chars-per-word)))))))


  (add-method (#^string (list-type) l)
    (if (null? l)
	""
	(let* ((len (length l))
	       (s (make string
			(quotient (+ len (- %chars-per-word 1))
				  %chars-per-word)
			len)))

	  (fill-string s l len)

	  ))))





; Note: the following 3 macros exist ONLY to
; improve the readability of the following procedure.
; They use %load-bp-i, and hence will break in other contexts.


(local-syntax (get-3-from-string instring i)
  `(let ((the-word (%load-bp-i ,i)))
     (list (%fixnum->character (bit-and 255 the-word))
	   (%fixnum->character
	    (ash-right (bit-and (ash-left 255 8) the-word) 8))
	   (%fixnum->character
	    (ash-right (bit-and (ash-left 255 16) the-word) 16)))))


(local-syntax (get-2-from-string instring i)
  `(let ((the-word (%load-bp-i ,i)))
     (list (%fixnum->character (bit-and 255 the-word))
	   (%fixnum->character
	    (ash-right (bit-and (ash-left 255 8) the-word) 8)))))


(local-syntax (get-1-from-string instring i)
  `(let ((the-word (%load-bp-i ,i)))
     (list (%fixnum->character (bit-and 255 the-word)))))



(let ((quick-vref-helper (make operation)))

  (add-method (quick-vref-helper (variable-length-mixin) instring char-count)

    (let* ((n-in-last (modulo char-count %chars-per-word))
	   (n-full-words (quotient char-count %chars-per-word)))

      (iterate loop ((outlist
		      (if (zero? n-in-last) '()
			  (if (= 1 n-in-last)
			      (get-1-from-string instring n-full-words)
			      (get-2-from-string instring n-full-words))))
		     (down-counter (- n-full-words 1)))

	(if (negative? down-counter)
	    outlist
	    (let ((next-triple (get-3-from-string instring down-counter)))
	      (set (cdddr next-triple) outlist)
	      (loop next-triple (- down-counter 1)))))))


  (add-method (#^list-type (string char-count) instring)
    (quick-vref-helper instring char-count)))






#|
(add-method (#^string (list-type) l)
  (if (null? l) ""
      (let* ((len (length l))
	     ;;(s (make-string len))
	     (s (make string
		      (quotient (+ len (- %chars-per-word 1)) %chars-per-word)
		      len)))
	(iterate aux ((i 0)(l l)(to-do len))
	  (cond ((zero? to-do) s)
		((= 1 to-do)
		 (set! (%vref s i) (%character->fixnum (car l)))
		 s)
		((= 2 to-do)
		 (set! (%vref s i)
		      (bit-or (%character->fixnum (car l))
			      (ash-left (%character->fixnum (cadr l)) 8)))
		 s)
		(else
		 (let* ((c0 (%character->fixnum (car l)))
			(l1 (cdr l))
			(c1 (%character->fixnum (car l1)))
			(l2 (cdr l1))
			(c2 (%character->fixnum (car l2))))
		   (set! (%vref s i)
			(bit-or c0 (bit-or (ash-left c1 8) (ash-left c2 16))))
		   (aux (+ i 1) (cdr l2) (- to-do %chars-per-word)))))))))

|#


(add-method (#^string (character) s)
  (#^string (list s)))


(define-instance write-string operation)

(add-method (write-string (string char-count) self stream)
  (dotimes (i char-count)
    (write-char stream (nth self i))))

(add-method (reverse (string char-count) self)
  (let ((new (make-string char-count)))
    (dotimes (i char-count new)
      (set! (nth new i) (nth self (- char-count (+ i 1)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; String predicates
;;;

(add-method (= (string) x y)
  (equal? x y))


;;; Strings are compared a machine word at a time rather than a
;;; character at a time.  The bytes of the last word above character
;;; N-CHARS are padding and belong to no character, so they are masked
;;; off instead of compared: this used to rely on every constructor
;;; leaving them zero, an assumption the file has carried a warning
;;; about since 1987 and which MAKE-STRING's fill character duly broke.
;;; STRING-HASH-KEY masks the same word the same way, so EQUAL? strings
;;; still hash alike.

(labels (((string-guts-equal? a b n-chars)
	  (let ((n-full (quotient n-chars %chars-per-word))
		(n-in-last (modulo n-chars %chars-per-word))
		(a-loc (make-locative (%vref-nocheck a 0)))
		(b-loc (make-locative (%vref-nocheck b 0))))

	    (and (or (zero? n-in-last)
		     (let ((mask (%string-last-word-mask n-chars)))
		       (= (bit-and mask
				   (contents
				    (%increment-locative a-loc n-full)))
			  (bit-and mask
				   (contents
				    (%increment-locative b-loc n-full))))))
		 (iterate aux ((i (- n-full 1)))
		   (cond ((negative? i) #t)
			 ((= (contents (%increment-locative a-loc i))
			     (contents (%increment-locative b-loc i)))
			  (aux (- i 1)))
			 (else #f)))))))


  (add-method (equal? (string) a b)
    (or (eq? a b)
	(and (eq? (get-type a) (get-type b))
	     (let ((l (length a)))
	       (and (= l (length b))
		    (or (zero? l)
			(string-guts-equal? a b l))))))))



(add-method (< (string) s1 s2)
  (let ((l1 (length s1))
	(l2 (length s2)))
    (iterate aux ((i 0))
      (cond ((= i l2) #f)
	    ((= i l1) #t)
	    ((< (%character->fixnum (nth s1 i))
		(%character->fixnum (nth s2 i))) #t)
	    ((> (%character->fixnum (nth s1 i))
		(%character->fixnum (nth s2 i))) #f)
	    (else (aux (+ i 1)))))))

(add-method (upcase (character) c)
  (let ((c (%character->fixnum c)))
    (%fixnum->character
     (cond ((and (<= (#^number #\a) c)
		 (<= c (#^number #\z)))
	    (- c (- (#^number #\a) (#^number #\A))))
	   (else c)))))

(add-method (downcase (character) c)
  (let ((c (%character->fixnum c)))
    (%fixnum->character
     (cond ((and (<= (#^number #\A) c)
		 (<= c (#^number #\Z)))
	    (- c (- (#^number #\A) (#^number #\a))))
	   (else c)))))

(add-method (upcase (string) self)
  (#^string (map upcase (#^list-type self))))

(add-method (downcase (string) self)
  (#^string (map downcase (#^list-type self))))


(define (write-string-with-slashes s delimiter-to-avoid stream)
  (dotimes (i (length s))
    (let ((c (nth s i)))
      (if (or (eq? c delimiter-to-avoid)
	      (eq? c #\\))
	  (write-char stream #\\))
      (write-char stream c))))

(define-instance requires-slashification? operation)

(add-method (requires-slashification? (string) s)
  (let ((len (length s)))
    (iterate aux ((i 0))
      (if (= i len) #f
	  (let ((c (nth s i)))
	    (or (eq? c #\")
		(eq? c #\\)
		(aux (+ i 1))))))))



; the coercion here between strings and char-lists
; is for speed, not just convenience.

(add-method (append (string) . rest)
  (listify-args
   (lambda (args)
     (#^string
      (apply append
	     (map (lambda (x)
		    (let ((x (if (is-a? x forcible) (force x) x)))
		      (if (not (string? x))
			  (append-type-error "string" x)
			  (#^list-type x))))
		  args))))
   . rest))




#|
(add-method (append (string char-count) x y)
  (let* ((y (#^string y))
	 (l1 (length y))
	 (l2 (+ char-count l1))
	 (s (make-string l2)))
    (dotimes (i char-count
		(iterate aux ((i char-count) (j 0))
		  (cond ((< j l1)
			 (set! (nth s i) (nth y j))
			 (aux (+ i 1) (+ j 1)))
			(else s))))
      (set! (nth s i) (nth x i)))))
|#


; this method is simply wrong
; (add-method (copy (string char-count) s)
;   (if (zero? char-count) s
;       (let ((l (quotient (+ len (- %chars-per-word 1)) %chars-per-word))
; 	    (n (make string l char-count)))
; 	(dotimes (i l n)
; 	  (set! (%vref n i) (%vref s i))))))



(add-method (copy (string char-count) s)
  (if (zero? char-count) s
      (let* ((l (quotient (+ char-count (- %chars-per-word 1))
			  %chars-per-word))
	     (n (make string l char-count)))
	(dotimes (i l n)
	  (set! (%vref n i) (%vref s i))))))



(add-method (remove (string) s c)
  (#^string (remove (#^list-type s) c)))



(add-method (subseq (string) self index len)
  (let ((new (make-string len)))
    (dotimes (i len)
      (set! (nth new i) (nth self (+ index i))))
    new))

