;;; This is a compatibility package for R3RS Scheme.

;;; This file defines things that are part of R3RS but that are not
;;; part of standard Oaklisp, usually because they are non-generic
;;; versions of operations which have generic variants in Oaklisp, but
;;; sometimes because we just decided to be gratuitously incompatible.

;(define (boolean? x) #f)
;(add-method (boolean? (truths) x) #t)
;
;(define (boolean? x) (is-a? x truths))
;
;(define (boolean? x) (or (eq? #f x) (eq? #t x)))
;
;(define (boolean? x) (if (not x) #t (eq? x #t)))
;
(define (boolean? x) (eq? x (not (not x))))


(define-constant set-car! (setter car))
(define-constant set-cdr! (setter cdr))

(define list-tail tail)
(define list-ref nth)

(define symbol->string #^string)

(define string->symbol #^symbol)

(define-constant char=?  =)
(define-constant char<?  <)
(define-constant char>?  >)
(define-constant char<=? <=)
(define-constant char>=? >=)

(define char-ci=?  (lambda (c1 c2) (=  (upcase c1) (upcase c2))))
(define char-ci<?  (lambda (c1 c2) (<  (upcase c1) (upcase c2))))
(define char-ci>?  (lambda (c1 c2) (>  (upcase c1) (upcase c2))))
(define char-ci<=? (lambda (c1 c2) (<= (upcase c1) (upcase c2))))
(define char-ci>=? (lambda (c1 c2) (>= (upcase c1) (upcase c2))))

(define (char-whitespace? c)
  (eq? 'whitespace (nth standard-read-table c)))


(define char->integer #^number)
(define integer->char #^character)

(define char-upcase upcase)
(define char-downcase downcase)



(define string-length length)
(define string-ref nth)
(define string-set! (setter nth))


(define-constant string=?  =)
(define-constant string<?  <)
(define-constant string>?  >)
(define-constant string<=? <=)
(define-constant string>=? >=)

(define string-ci=?  (lambda (c1 c2) (=  (upcase c1) (upcase c2))))
(define string-ci<?  (lambda (c1 c2) (<  (upcase c1) (upcase c2))))
(define string-ci>?  (lambda (c1 c2) (>  (upcase c1) (upcase c2))))
(define string-ci<=? (lambda (c1 c2) (<= (upcase c1) (upcase c2))))
(define string-ci>=? (lambda (c1 c2) (>= (upcase c1) (upcase c2))))

(define substring subseq-indexes)

; (define string-append append)

;;; Written in terms of a list of arguments rather than native rest
;;; args: this file is loaded into SCHEME-LOCALE, where a dotted
;;; parameter list always binds a list, and R3RS callers expect that
;;; too.
(define (string-append . args)
  (if (null? args)
      "" (apply append args)))


(define string->list #^list-type)
(define list->string #^string)

(define string-copy copy)
(define string-fill! fill!)


;;; R3RS makes the fill optional; without one the elements are whatever
;;; MAKE leaves behind, which is what this always did.

(define (make-vector n . fill)
  (let ((v (make simple-vector n)))
    (if (null? fill) v (fill! v (car fill)))))

(define vector-length length)
(define vector-ref nth)
(define vector-set! (setter nth))
(define vector->list #^list-type)
(define list->vector #^simple-vector)
(define vector-fill! fill!)



(define input-port? (type-pred input-stream))
(define output-port? (type-pred output-stream))

(define (call-with-input-file string proc)
  (with-open-file (s string in)
    (proc s)))

(define (call-with-output-file string proc)
  (with-open-file (s string out)
    (proc s)))

(define (current-input-port) standard-input)
(define (current-output-port) standard-output)

(define (eof-object? x)
  (eq? x the-eof-token))

(define close-input-port close)
(define close-output-port close)

(define write
  (let ((write0 (lambda (obj port)
		  (bind ((#*print-escape #t))
		    (print obj port)))))

    (lambda (obj . rest)
      (if (null? rest)
	  (write0 obj standard-output)
	  (write0 obj (car rest))))))

(define display
  (let ((display0 (lambda (obj port)
		  (bind ((#*print-escape #f))
		    (print obj port)))))

    (lambda (obj . rest)
      (if (null? rest)
	  (display0 obj standard-output)
	  (display0 obj (car rest))))))

;;; Argument order incompatibility hackaround:

(add-method (write-char (character) char stream)
  (write-char stream char))

;;; with no args:

(add-method (newline (object)) (newline standard-output))

(define (write-line x) (print x standard-output))

#| (add-method (read (object)) (read standard-input)) |#


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Numeric type predicates.

;;; Oaklisp's numeric tower is exact throughout, and R3RS says COMPLEX?
;;; is true of every number.

(define rational? (type-pred rational))
(define real? (type-pred real))
(define complex? (type-pred number))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Character classification.

;;; Done on character codes rather than on the reader's table, so that
;;; these mean the same thing whatever the read table happens to say.

(define (char-alphabetic? c)
  (let ((n (char->integer c)))
    (or (and (>= n 65) (<= n 90))
	(and (>= n 97) (<= n 122)))))

(define (char-numeric? c)
  (let ((n (char->integer c)))
    (and (>= n 48) (<= n 57))))

(define (char-upper-case? c)
  (let ((n (char->integer c)))
    (and (>= n 65) (<= n 90))))

(define (char-lower-case? c)
  (let ((n (char->integer c)))
    (and (>= n 97) (<= n 122))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Numbers to strings and back.

(define (number->string n . rest)
  (let ((s (make string-output-stream)))
    (bind ((#*print-radix (if (null? rest) 10 (car rest)))
	   (#*print-escape #f))
      (print n s))
    (#^string s)))

;;; The value of C as a digit in RADIX, or #f if it isn't one.

(define (char->digit c radix)
  (let* ((n (char->integer c))
	 (v (cond ((and (>= n 48) (<= n 57)) (- n 48))	;0-9
		  ((and (>= n 97) (<= n 122)) (- n 87))	;a-z
		  ((and (>= n 65) (<= n 90)) (- n 55))	;A-Z
		  (else #f))))
    (and v (< v radix) v)))

;;; R3RS wants #f rather than an error for anything that is not a
;;; number in RADIX.  Accepts the #b #o #d #x radix prefixes and the
;;; #e #i exactness prefixes -- every number here is exact already, so
;;; #i is accepted and ignored -- a sign, and an integer or a ratio.

(define (string->number str . rest)
  (let ((end (length str)))
    (labels
	(((digits i j radix)
	  (and (< i j)
	       (iterate aux ((i i) (acc 0))
		 (if (= i j)
		     acc
		     (let ((d (char->digit (nth str i) radix)))
		       (and d (aux (+ i 1) (+ (* acc radix) d))))))))

	 ((unsigned i j radix)
	  (iterate look ((k i))
	    (cond ((= k j) (digits i j radix))
		  ((eq? (nth str k) #\/)
		   (let ((num (digits i k radix))
			 (den (digits (+ k 1) j radix)))
		     (and num den (not (zero? den)) (/ num den))))
		  (else (look (+ k 1))))))

	 ((signed i j radix)
	  (cond ((= i j) #f)
		((eq? (nth str i) #\-)
		 (let ((v (unsigned (+ i 1) j radix)))
		   (and v (- v))))
		((eq? (nth str i) #\+) (unsigned (+ i 1) j radix))
		(else (unsigned i j radix))))

	 ((prefixed i j radix)
	  (if (and (< (+ i 1) j) (eq? (nth str i) #\#))
	      (let ((c (downcase (nth str (+ i 1)))))
		(cond ((eq? c #\b) (prefixed (+ i 2) j 2))
		      ((eq? c #\o) (prefixed (+ i 2) j 8))
		      ((eq? c #\d) (prefixed (+ i 2) j 10))
		      ((eq? c #\x) (prefixed (+ i 2) j 16))
		      ((eq? c #\e) (prefixed (+ i 2) j radix))
		      ((eq? c #\i) (prefixed (+ i 2) j radix))
		      (else #f)))
	      (signed i j radix))))

      (prefixed 0 end (if (null? rest) 10 (car rest))))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; More ports.

;;; None of this implementation's input streams can block waiting for a
;;; character that never arrives, and R3RS only requires CHAR-READY? to
;;; answer #t when READ-CHAR will not have to wait.

(define (char-ready? . rest) #t)

(define (with-input-from-file string thunk)
  (let ((s (open-input-file string))
	(old standard-input))
    (wind-protect (set! standard-input s)
		  (thunk)
		  (block (set! standard-input old) (close s)))))

(define (with-output-to-file string thunk)
  (let ((s (open-output-file string))
	(old standard-output))
    (wind-protect (set! standard-output s)
		  (thunk)
		  (block (set! standard-output old) (close s)))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; More numbers.

;;; Every number in this system is exact, so the two conversions are
;;; the identity, and the complex operations that need no floating
;;; point are the ones this locale was missing.

(define (make-rectangular x y) (make-complex x y))
(define magnitude abs)
(define (exact->inexact x) x)
(define (inexact->exact x) x)

;;; The simplest rational within E of X, by the usual continued
;;; fraction argument.  Exact throughout, so no floats are needed here
;;; either.

(define rationalize
  (labels (((simplest-positive x y)		;0 < x < y
	    (let ((fx (floor x))
		  (fy (floor y)))
	      (cond ((not (< fx x)) fx)
		    ((= fx fy)
		     (+ fx (/ 1 (simplest-positive (/ 1 (- y fy))
						   (/ 1 (- x fx))))))
		    (else (+ fx 1)))))
	   ((simplest x y)
	    (cond ((< y x) (simplest y x))
		  ((= x y) x)
		  ((positive? x) (simplest-positive x y))
		  ((negative? y) (- (simplest-positive (- y) (- x))))
		  (else 0))))
    (lambda (x e)
      (let ((e (abs e)))
	(simplest (- x e) (+ x e))))))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Names this locale has to shadow.

;;; DEFINE writes through to the inherited cell when SYSTEM-LOCALE
;;; already has the name, and FREEZE-IN-CURRENT-LOCALE then reports
;;; that the symbol is not installed here, so a shadow needs a cell of
;;; its own first.  Freezing the value is what lets the compiler open
;;; code it in files compiled into this locale.

(define (shadow-in-current-locale sym val)
  (let ((cell (or (variable-here? #*current-locale sym)
		  (set! (variable-here? #*current-locale sym) #t))))
    (set! (contents cell) val)
    (set! (frozen-here? #*current-locale sym) #t)
    val))


;;; R3RS makes the five numeric comparisons n-ary, (< x1 x2 x3 ...).
;;; The Oaklisp operations these shadow are strictly binary --
;;; doc/lang/numbers.tex documents them that way -- and a third
;;; argument was not even a runtime error but "CodeGen: Wrong number of
;;; arguments" out of the compiler.
;;;
;;; The chain is open coded, the way MAX and MIN are, so two arguments
;;; still compile to the instruction they always did.  Arguments arrive
;;; on the stack with the first one on top, so each step copies the top
;;; two, compares them and drops the first; a comparison that fails
;;; branches into a chain of pops that unwinds whatever is left, so
;;; every exit leaves exactly one value where the n arguments were.

(define (%chain-compare op a l)
  (cond ((null? l) #t)
	((op a (car l)) (%chain-compare op (car l) (cdr l)))
	(else #f)))

(define (%n-ary-comparison name binary-op binary-code)
  (let ((op
	 (make-fancy-open-coded-operation
	  (list foldable-mixin)
	  (lambda (n)
	    (cond
	     ((< n 2)
	      (error "~A requires at least two arguments." name))
	     ((= n 2) (copy binary-code))
	     (else
	      (let ((fails (map (lambda (i) (generate-symbol 'cmp-fail))
				(iota (- n 1))))
		    (done (generate-symbol 'cmp-done)))
		(append
		 (splice (map (lambda (lab)
				`((load-stk 1)
				  (load-stk 1)
				  ,@(copy binary-code)
				  (branch-nil ,lab)
				  (pop 1)))
			      fails))
		 `((pop 1) (load-imm #t) (branch ,done))
		 (splice (map (lambda (lab) `((label ,lab) (pop 1)))
			      fails))
		 `((pop 1) (load-imm ()) (label ,done)))))))
	  nil 1)))

    (add-method (op (object) x y . args)
      (if (binary-op x y)
	  (listify-args (lambda (rest) (%chain-compare binary-op y rest))
			. args)
	  (consume-args #f . args)))
    op))

(shadow-in-current-locale '=  (%n-ary-comparison "="  =  '((=))))
(shadow-in-current-locale '<  (%n-ary-comparison "<"  <  '((<))))
(shadow-in-current-locale '>  (%n-ary-comparison ">"  >  '((swap 1) (<))))
(shadow-in-current-locale '<= (%n-ary-comparison "<=" <= '((swap 1) (<) (not))))
(shadow-in-current-locale '>= (%n-ary-comparison ">=" >= '((<) (not))))


;;; R3RS requires the standard types to be disjoint, and LIST? to be
;;; false for an improper list.  Oaklisp's lattice makes STRING a
;;; subtype of SIMPLE-VECTOR and CONS-PAIR a subtype of LIST-TYPE, so
;;; its own VECTOR? and LIST? answer #t for a string and for (1 . 2).
;;; Both answers are defensible inside Oaklisp; only these shadows have
;;; to be R3RS.

(shadow-in-current-locale
 'vector?
 (let ((op (make operation)))
   (add-method (op (forcible) self) (op (force self)))
   (add-method (op (object) self) #f)
   (add-method (op (simple-vector) self) #t)
   (add-method (op (string) self) #f)
   op))

(shadow-in-current-locale
 'list?
 (lambda (x)
   ;; Tortoise and hare, so a circular list answers #f rather than
   ;; walking forever.
   (iterate step ((slow x) (fast x))
     (cond ((null? fast) #t)
	   ((not (pair? fast)) #f)
	   (else
	    (let ((fast (cdr fast)))
	      (cond ((null? fast) #t)
		    ((not (pair? fast)) #f)
		    (else
		     (let ((fast (cdr fast))
			   (slow (cdr slow)))
		       (and (not (eq? fast slow))
			    (step slow fast)))))))))))

