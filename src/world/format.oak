;;; Formatted output.  Fancy version with modularity and lots of features.

;;; Format directive syntax:
;;;
;;; <directive> ::= '~' LISTOF( { <char> | <number> | '' } ) [':'] ['@'] <control-char>
;;; LISTOF(x) ::= { '' | { x ',' }* x }
;;; <char> ::= ''' <character>
;;; <number> ::= [ '+' | '-' ] <digit>+
;;;

(let ((formats (lambda (arglist)
		 (apply format arglist)
		 (#^string (car arglist)))))

  (define (format stream control-string . args)
    (if (null? stream)
	(let ((s (make string-output-stream)))
	  (listify-args formats s control-string . args))
	(formati (if (eq? stream #t) standard-output stream)
		 control-string 0 (length control-string) . args))))


(define (formati stream control-string index limit . args)
  (iterate aux ((index index))
    (if (< index limit)
	(let ((char (nth control-string index)))
	  (cond ((eq? char #\~)
		 (format-parse-directive stream control-string
					 (+ index 1) limit . args))
		(else (write-char stream char)
		      (aux (+ index 1)))))
	(if (zero? (rest-length args))
	    #f
	    (listify-args format-arg-count-error stream control-string . args)))))

(define (format-arg-count-error arglist)
  (destructure (stream control-string . arglist) arglist
    (cerror
     "Ignore the excess arguments."
     "After processing ~S to ~A, ~D argument~P ~S remained unconsumed."
     control-string stream (length arglist) (length arglist) arglist)))


;;; Fetch the next character of a directive.  Running past the end of
;;; the control string means the string ended in the middle of a
;;; directive, which is worth saying so rather than reporting an index
;;; out of bounds against the control string.

(define (format-directive-char control-string index limit)
  (if (< index limit)
      (nth control-string index)
      (error "The control string ~S ends in the middle of a directive."
	     control-string)))

(define (format-parse-directive stream control-string index limit . args)
  (labels ((parse-list
	    (lambda (char index the-list)
	      (cond ((eq? char #\,)
		     (parse-list (format-directive-char control-string index limit)
				 (+ index 1)
				 (cons nil the-list)))
		    ((eq? char #\')
		     (let ((quoted-char (format-directive-char control-string index limit)))
		       (eat-comma (format-directive-char control-string (+ index 1) limit)
				  (+ index 2) (cons quoted-char the-list))))
		    ((number-starter? char)
		     (labels ((parse-number
			       (lambda (char index num neg?)
				 (let ((cn (#^number char)))
				   (cond ((and (<= (#^number #\0) cn)
					       (<= cn (#^number #\9)))
					  (parse-number
					   (format-directive-char control-string index limit)
					   (+ index 1)
					   (+ (* num 10) (- cn (#^number #\0)))
					   neg?))
					 (else
					  (eat-comma
					   char index
					   (cons (if neg? (- num) num)
						 the-list))))))))
			     (cond ((eq? char #\-)
				    (parse-number (format-directive-char control-string index limit)
						  (+ index 1) 0 #t))
				   ((eq? char #\+)
				    (parse-number (format-directive-char control-string index limit)
						  (+ index 1) 0 #f))
				   (else
				    (parse-number char index 0 #f)))))
		    (else (find-colon char index the-list)))))
	   (eat-comma (lambda (char index the-list)
			(if (eq? char #\,)
			    (parse-list (format-directive-char control-string index limit)
					(+ index 1) the-list)
			    (parse-list char index the-list))))
	   (find-colon (lambda (char index the-list)
			 (if (eq? char #\:)
			     (find-atsign (format-directive-char control-string index limit)
					  (+ index 1) the-list #t)
			     (find-atsign char index the-list #f))))
	   (find-atsign (lambda (char index the-list colon?)
			  (if (eq? char #\@)
			      (terminate (format-directive-char control-string index limit)
					 (+ index 1) the-list colon? #t)
			      (terminate char index the-list colon? #f))))
	   (terminate
	    (lambda (char index the-list colon? atsign?)
	      (destructure (arg-count op) (nth format-control-table
					       (#^number (upcase char)))
		(cond ((eq? 0 arg-count)
		       (op the-list colon? atsign? char stream)
		       (formati stream control-string index limit . args))
		      ((eq? 1 arg-count)
		       ;; FORMATI1 takes the argument to print as its tenth
		       ;; parameter, so running out of arguments used to
		       ;; surface as a nargs error against it, with its whole
		       ;; parameter list printed.  Nothing is passed along
		       ;; here because there is nothing left to pass.
		       (if (zero? (rest-length args))
			   (error "The ~~~C directive in ~S has no argument left to print."
				  char control-string)
			   (formati1 stream control-string index limit
				     the-list colon? atsign? char op . args)))
		      (else
		       (error "Format control arg may be only 0 or 1.")))))))

       (parse-list (format-directive-char control-string index limit) (+ index 1) '())))

(define (formati1 stream control-string index limit
		  the-list colon? atsign? char op arg . args)
  (op the-list colon? atsign? char stream arg)
  (formati stream control-string index limit . args))

(define (number-starter? c)
  (or (eq? c #\+)
      (eq? c #\-)
      (eq? c #\0)
      (eq? c #\1)
      (eq? c #\2)
      (eq? c #\3)
      (eq? c #\4)
      (eq? c #\5)
      (eq? c #\6)
      (eq? c #\7)
      (eq? c #\8)
      (eq? c #\9)))


;;; A general way to define format control thingies:

(define-instance format-control-table simple-vector 128)

;;; An unknown directive takes no argument: asking for one made
;;; (format #f "~^") report a nargs error against FORMATI1 rather than
;;; naming the directive it could not understand.

(let ((x (list 0
	       (lambda (the-list colon? atsign? char stream)
		 (error "Unknown format control character ~C." char)))))

  (dotimes (i 128)
    (set! (nth format-control-table i) x)))

(define (define-format-control char arg-count lamb)
  (set! (nth format-control-table (#^number (upcase char)))
       (list arg-count lamb)))

;;; Numeric parameters.  The manual says a ~ "may be followed by a
;;; number ... which vary the action that would normally be taken", but
;;; FORMAT-PARSE-DIRECTIVE collected them and only ~nR ever looked.
;;; These are the Common Lisp mincol and padchar parameters: ~<mincol>D
;;; pads on the left to that width, ~<mincol>A pads on the right, and a
;;; second parameter -- ~<mincol>,'<char>D -- gives the pad character.
;;;
;;; PARSE-DIRECTIVE conses the parameters up as it reads them, so the
;;; list arrives reversed; FORMAT-PARAMETER indexes it in the order they
;;; were written.  IS-A? rather than the type predicates because this
;;; file is loaded into the cold world well before predicates.oak.

(define (format-parameter the-list n)
  (iterate step ((l (reverse the-list)) (n n))
    (cond ((null? l) '())
	  ((zero? n) (car l))
	  (else (step (cdr l) (- n 1))))))

(define (format-pad stream the-list first pad-left? thunk)
  (let ((mincol (format-parameter the-list first)))
    (if (not (is-a? mincol fixnum))
	(thunk stream)
	(let ((padchar (let ((c (format-parameter the-list (+ first 1))))
			 (if (is-a? c character) c #\space)))
	      (s (make string-output-stream)))
	  (thunk s)
	  (let* ((str (#^string s))
		 (n (- mincol (length str))))
	    (when (not pad-left?) (write-string str stream))
	    (dotimes (i n) (write-char stream padchar))
	    (when pad-left? (write-string str stream)))))))

;;; The way they work:

(define-format-control #\A 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #f
		(lambda (out)
		  (bind ((#*print-escape #f))
		    (print arg out))))))

(define-format-control #\~ 0
  (lambda (the-list colon? atsign? char stream)
    (write-char stream #\~)))

(define-format-control #\% 0
  (lambda (the-list colon? atsign? char stream)
    (newline stream)))

(define-format-control #\& 0
  (lambda (the-list colon? atsign? char stream)
    (freshline stream)))

(define-format-control #\S 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #f
		(lambda (out)
		  (bind ((#*print-escape #t))
		    (print arg out))))))

(define-format-control #\B 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #t
		(lambda (out)
		  (bind ((#*print-radix 2))
		    (print arg out))))))

(define-format-control #\D 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #t
		(lambda (out)
		  (bind ((#*print-radix 10))
		    (print arg out))))))

(define-format-control #\O 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #t
		(lambda (out)
		  (bind ((#*print-radix 8))
		    (print arg out))))))

(define-format-control #\X 1
  (lambda (the-list colon? atsign? char stream arg)
    (format-pad stream the-list 0 #t
		(lambda (out)
		  (bind ((#*print-radix 16))
		    (print arg out))))))

;;; ~R takes the radix as its first parameter, so its mincol and
;;; padchar are the second and third.

(define-format-control #\R 1
  (lambda (the-list colon? atsign? char stream arg)
    (let ((radix (format-parameter the-list 0)))
      (cond ((null? radix)
	     (error "Roman numerals are not yet implemented."))
	    (else
	     (format-pad stream the-list 1 #t
			 (lambda (out)
			   (bind ((#*print-radix radix))
			     (print arg out)))))))))

(define-format-control #\C 1
  (lambda (the-list colon? atsign? char stream arg)
    ;; Like ~A, and unlike leaving it to whatever #*PRINT-ESCAPE
    ;; happens to be bound to out here.
    (format-pad stream the-list 0 #f
		(lambda (out)
		  (bind ((#*print-escape #f))
		    (print arg out))))))

(define-format-control #\P 1
  (lambda (the-list colon? atsign? char stream arg)
    (if (!= arg 1)
	(write-char stream #\s))))

(define-format-control #\! 1
  (lambda (the-list colon? atsign? char stream arg)
    (cond ((and #*fancy-references
		(reasonable-expression #*current-locale arg))
	   => (lambda (expr)
		(format stream "~S " expr))))
    (bind ((#*print-radix 10))
      (print (object-hash arg) stream))))

;;; This can't be CL compatible, because it has no way to communicate a new
;;; index back to the main routine.
;;;
;;; Ultimately, this should ignore whitespace following the newline.

(define-format-control #\newline 0
  (lambda (the-list colon? atsign? char stream)
    ))

;;; eof
