#!/bin/sh
# oakc - build a stand-alone executable, straight C, from Oaklisp sources.
#
# usage: oakc [options] file.oak... [-o prog]
#
#   -o PROG          name the executable (default: first source, no extension)
#   --eval EXPR      evaluate EXPR (Oaklisp) after the program runs;
#                    may be repeated, runs in order
#   --locale NAME    compile and run in this locale (default system-locale)
#   --runtime DIR    the native runtime built by "make native-world"
#                    (default: this build tree's src/world/native)
#   -w, --whole-program
#                    whole-program mode (CompilerPlan.md): every file
#                    is first summarized (.ois), then recompiled with
#                    all the summaries in hand, so calls resolve
#                    statically across files and into the runtime,
#                    guarded by the operation compiled against; a
#                    generated link-time prelude pins what the guards
#                    compare.  Declares a closed world: no new methods
#                    at run time on the operations it resolves.
#   --ir             the C-locals lowering: within trap-free runs the
#                    stack top lives in C locals rather than memory
#                    (the plan's IR back end; see native-compiler.oak)
#   --interpreter    link the bytecode interpreter in, for programs
#                    that eval or compile non-trivial forms at run
#                    time; compiled code still runs native
#   --strip          dead code removal: empty the locales before the
#                    world is dumped, so the image loses everything
#                    the program does not reach, and leave out the
#                    runtime modules whose code nothing surviving
#                    names (most of the compiler, usually).  Nothing
#                    can be looked up by name afterwards, so no
#                    --interpreter with it, and --eval is limited to
#                    the globals it names (oakc keeps those)
#   --keep           keep the work directory and say where it is
#
# The executable is C through and through: each source is compiled to
# C (strict mode - everything must translate), the program is linked
# into the native world at build time (bake-file) and the world dumped,
# and the generated main.c carries that image as data, registers the
# program's and the runtime's native modules, and enters the native
# call driver.  No interpreter is linked in - nm PROG shows no loop -
# no bytecode runs, and nothing is loaded or parsed at startup beyond
# the image bytes.  Arguments given to the executable are visible to
# the program through the argument line, after the built-in switches
# and a "--".
#
# Runtime EVAL or COMPILE of anything but trivial forms produces
# bytecode, which such an executable cannot run ("bytecode reached").
# --interpreter is the escape hatch (CompilerPlan.md): the same baked
# world and native modules, entered through the emulator instead of
# the native call driver, so evaled code runs in the interpreter while
# everything compiled stays native.  oakc warns when a program names
# eval or compile and --interpreter was not given.
#
# This script is generated by configure and runs out of the build tree.

builddir='@abs_top_builddir@'
srcdir='@abs_top_srcdir@'
CC='@CC@'
CFLAGS='@CFLAGS@'
LIBS='@LIBS@'
OAKC_FAST='@OAKC_FAST@'

EMUDIR=$builddir/src/emulator
OAKLISP=${OAKC_OAKLISP:-$EMUDIR/oaklisp}
INCLUDES="-DHAVE_CONFIG_H $OAKC_FAST -I$srcdir/src/emulator -I$builddir"

out=
locale=system-locale
keep=no
runtime=$builddir/src/world/native
engine=native
strip=no
wp=no
irbind=
sources=
evals=

fail() { echo "oakc: $*" >&2; exit 1; }

while test $# -gt 0; do
  case $1 in
    -o) out=$2; shift 2;;
    --eval) test $# -ge 2 || fail "--eval needs an expression"
	    evals="$evals
$2"; shift 2;;
    --locale) locale=$2; shift 2;;
    --runtime) runtime=$2; shift 2;;
    -w|--whole-program) wp=yes; shift;;
    --ir) irbind="(#*native-ir? #t) "; shift;;
    --interpreter) engine=embedded; shift;;
    --strip) strip=yes; shift;;
    --keep) keep=yes; shift;;
    -h|--help) sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    -*) fail "unknown option $1";;
    *) sources="$sources $1"; shift;;
  esac
done

test -n "$sources" || fail "no source files (oakc --help)"
test $strip = yes && test $engine = embedded \
  && fail "--strip and --interpreter exclude each other: eval needs the locales"
test -x "$OAKLISP" || fail "no emulator at $OAKLISP (build the tree first)"
test -f "$runtime/oakworld.bin" && test -f "$runtime/liboaknat.a" \
  || fail "no native runtime in $runtime (make -C src/world native-world)"
runtime=`cd "$runtime" && pwd`
WORLD=$runtime/oakworld.bin
RUNTIME_MODS=`for m in "$runtime"/*.so; do printf ' --native-module %s' "$m"; done`

work=$(mktemp -d "${TMPDIR:-/tmp}/oakc.XXXXXX") || fail "mktemp failed"
test $keep = yes || trap 'rm -rf "$work"' 0
test $keep = yes && echo "oakc: work directory $work"

# 1. Compile each source to C, strictly: an executable has no emulator
#    to escape to.  compile_one STEM BASE BINDS runs the compiler with
#    the given extra fluid bindings; the C compiler never runs in the
#    emulator (oakc compiles below, with -DON_STATIC).
compile_one() {
  "$OAKLISP" --batch $RUNTIME_MODS --world "$WORLD" -- \
    --locale compiler-locale \
    --outdir "$work" \
    --eval "(bind ((#*compiler-noisiness 0) (#*native-strict? #t) (#*native-emit-only? #t) $irbind$3) (native-compile-file $locale \"$1\"))" \
    --exit >"$work/$2.compile.log" 2>&1 \
    || { cat "$work/$2.compile.log" >&2; fail "compiling $1 failed"; }
  test -f "$work/$2.c" || { cat "$work/$2.compile.log" >&2
			    fail "no C for $1"; }
}

objs=
prefixes=
bases=
for src in $sources; do
  test -f "$src" || fail "no such file: $src"
  case $src in *.oak) ;; *) fail "$src: sources are .oak files";; esac
  base=$(basename "$src" .oak)
  stem=${src%.oak}
  echo "oakc: compiling $src"
  compile_one "$stem" "$base" ""
  bases="$bases $base:$stem"
done

# 1b. Whole-program: with every summary in hand, compile everything
#     again; calls now resolve statically, each file keeping its first
#     prefix so the summaries' names stay the linked names.  The cell
#     definitions the guards read are gathered into a prelude, baked
#     after the program so it pins what the program defined.
if test $wp = yes; then
  sumlist=
  for b in $bases; do
    sumlist="$sumlist \"$work/${b%%:*}\""
  done
  for b in $bases; do
    base=${b%%:*}; stem=${b#*:}
    prefix=$(sed -n 's/^;oaklisp-summary prefix=//p' "$work/$base.ois")
    test -n "$prefix" || fail "no prefix in $base.ois"
    echo "oakc: compiling $base.oak (whole program)"
    compile_one "$stem" "$base" "(#*native-whole-program? #t) (#*native-force-prefix \"$prefix\") (#*native-summaries (native-read-summaries (list $sumlist)))"
  done
  cat "$work"/*.needs > "$work/prelude.oak" 2>/dev/null
  if grep -q '^(define' "$work/prelude.oak"; then
    echo "oakc: compiling the link-time prelude"
    compile_one "$work/prelude" "prelude" ""
    bases="$bases prelude:$work/prelude"
    sources="$sources $work/prelude.oak"
  fi
fi

for b in $bases; do
  base=${b%%:*}
  prefix=$(sed -n 's/^#define ON_PREFIX[ 	]*//p' "$work/$base.c")
  test -n "$prefix" || fail "no ON_PREFIX in $base.c"
  echo "oakc: cc $base.c"
  $CC $CFLAGS $INCLUDES -DON_STATIC -c -o "$work/$base.o" "$work/$base.c" \
    || fail "compiling $base.c failed"
  objs="$objs $work/$base.o"
  prefixes="$prefixes $prefix"
done

# Straight C cannot run bytecode, which EVAL and COMPILE produce at run
# time.  The .oa's symbol list names every symbol the file references,
# so a mention of one of those is grounds for the warning the plan asks
# for -- conservative: the symbol may be data, and the call may never
# run.
if test $engine = native; then
  for src in $sources; do
    base=$(basename "$src" .oak)
    hits=$(head -c 4096 "$work/$base.oa" | tr ' ()' '\n\n\n' \
	     | grep -ixE 'eval|compile|compile-file' | sort -u | tr '\n' ' ')
    test -z "$hits" \
      || echo "oakc: warning: $src names $hits-- run-time eval of" \
	      "non-trivial forms needs --interpreter" >&2
  done
fi

# 2. Bake: link the program into the world without running it, and
#    dump the image the executable will carry.
echo "oakc: baking the world"
cmd="'$OAKLISP' --batch $RUNTIME_MODS --world '$WORLD' --dump '$work/baked.bin' --"
for src in $sources; do
  base=$(basename "$src" .oak)
  cmd="$cmd --eval '(bake-file $locale \"$work/$base\")'"
done
if test $strip = yes; then
  # The executable's command line still looks up RUN-BAKED-PROGRAM and
  # whatever the --eval forms name, so those survive the strip.
  keepsyms="run-baked-program $(printf '%s\n' "$evals" \
    | tr -c 'A-Za-z0-9%*/+<>=!?^._~-' '\n' \
    | grep -E '^[A-Za-z%*/+<>=!?^._~-]' | sort -u | tr '\n' ' ')"
  cmd="$cmd --eval '(strip-locales (quote ($keepsyms)))'"
fi
cmd="$cmd --exit"
eval "$cmd" > "$work/bake.log" 2>&1 || { cat "$work/bake.log" >&2
					 fail "baking failed"; }
test -f "$work/baked.bin" || { cat "$work/bake.log" >&2
			       fail "no baked world"; }

# 2b. With --strip, leave out every runtime module the stripped image
#     no longer names: its stubs were collected, so nothing can reach
#     its code, and a module table without it lets the linker leave
#     its object out of the executable.  A stub's function name is a
#     string packing word-size/8 - 1 characters per word, shifted left
#     2 (the fixnum tag), so unshifting every byte against its
#     neighbor makes the surviving names read out whole.  A stray
#     match can only keep a module too many.
runtime_refs='OAK_RUNTIME_MODULE_REFS'
if test $strip = yes; then
  ws=$(head -c 120 "$work/baked.bin" | sed -n 's/.*word-size=\([0-9]*\).*/\1/p')
  test -n "$ws" || fail "no word size in the baked image header"
  od -An -v -tu1 "$work/baked.bin" | awk -v w=$((ws / 8)) '
    { for (n = 1; n <= NF; n++) { b[k++] = $n;
	if (k == w) { for (j = 0; j < w - 1; j++) {
	    c = int(b[j] / 4) + (b[j + 1] % 4) * 64;
	    if (c >= 33 && c < 127) printf "%c", c; else printf "\n"; }
	  k = 0; } } }' \
    | grep -o 'oakn_[A-Za-z0-9_]*' | sort -u > "$work/image-names"
  runtime_refs=
  total=0 left=0
  for m in $(sed -n 's/^extern const oak_native_module \(.*\)_module;$/\1/p' \
	       "$runtime/oak-runtime-modules.h"); do
    total=$((total + 1))
    if grep -q "^${m}_" "$work/image-names"; then
      runtime_refs="$runtime_refs&${m}_module, "
      left=$((left + 1))
    fi
  done
  echo "oakc: stripped the runtime to $left of $total modules"
fi

# 3. Generate main.c: the baked image as data, the module table, the
#    built-in command line, the native entry.
hex() { od -An -v -tx1 "$1" | tr -s ' ' '\n' | sed '/^$/d; s/^/0x/; s/$/,/'; }

main=$work/oakc-main.c
{
  echo '/* Generated by oakc. */'
  echo '#include "oak-embed.h"'
  echo '#include "oak-runtime-modules.h"'
  echo 'static const unsigned char oakc_world[] = {'
  hex "$work/baked.bin"
  echo '};'
  for prefix in $prefixes; do
    echo "extern const oak_native_module ${prefix}_module;"
  done
  echo 'static const oak_native_module *const oakc_modules[] = {'
  for prefix in $prefixes; do
    echo "  &${prefix}_module,"
  done
  echo "  $runtime_refs"
  echo '  0};'
  echo 'static const char *const oakc_args[] = {'
  echo '  "--batch", "--", "--eval", "(run-baked-program)",'
  printf '%s\n' "$evals" | sed '/^$/d' \
    | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/  "--eval", "/; s/$/",/'
  echo '  "--exit"};'
  cat <<'EOF'
int
main(int argc, char **argv)
{
  static oak_embedding e;
  e.world = oakc_world;
  e.world_size = sizeof oakc_world;
  e.program = "";		/* marks an oakc executable: quiet boot */
  e.program_size = 0;
  e.modules = oakc_modules;
  e.module_count = sizeof oakc_modules / sizeof oakc_modules[0] - 1;
EOF
  # The native call driver, or with --interpreter the emulator: the
  # same baked world and modules, but evaled bytecode runs too.
  echo "  return oak_main_$engine(argc, argv, &e,"
  echo '			 oakc_args,'
  echo '			 (int)(sizeof oakc_args / sizeof oakc_args[0]));'
  echo '}'
} > "$main"

echo "oakc: cc main"
$CC $CFLAGS $INCLUDES -I"$runtime" -DON_STATIC -c -o "$work/oakc-main.o" "$main" \
  || fail "compiling the generated main.c failed"

# 4. Link: the program, the native runtime, the C runtime; no loop.o.
test -n "$out" || { first=$(set -- $sources; echo "$1")
		    out=$(basename "$first" .oak); }
echo "oakc: linking $out"
$CC $CFLAGS -o "$out" "$work/oakc-main.o" $objs \
    "$runtime/liboaknat.a" "$EMUDIR/liboakrt.a" $LIBS \
  || fail "linking $out failed"
exit 0
