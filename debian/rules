#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
# export DH_VERBOSE=1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
DOPACKAGES = $(shell dh_listpackages)

%:
	dh $@

# Do not use /usr/bin/oaklisp or /usr/lib/*/oaklisp.bin even if available
CONF_OPTIONS=--with-world=no --with-compile=guile

ifeq (,$(filter oaklisp-doc,$(DOPACKAGES)))
CONF_OPTIONS+=--disable-docs
endif

override_dh_auto_configure:
	dh_auto_configure -- $(CONF_OPTIONS)

override_dh_auto_install:
	dh_auto_install
	-rm --verbose debian/tmp/usr/share/doc/oaklisp/ChangeLog
	-rm --verbose debian/tmp/usr/share/doc/oaklisp/COPYING

override_dh_compress:
	dh_compress --exclude=.pdf
